<% content_for :title, "Create New Automation" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center">
      <%= link_to automations_path, class: "text-gray-400 hover:text-gray-600 mr-4" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-3xl font-bold text-gray-900">⚙️ Create New Automation</h1>
        <p class="mt-2 text-sm text-gray-700">
          Set up automated email sequences to engage your contacts.
        </p>
      </div>
    </div>
  </div>

  <!-- Form -->
  <div class="bg-white shadow rounded-lg">
    <div class="px-6 py-8">
      <%= form_with model: @automation, url: automations_path, local: true, class: "space-y-6" do |form| %>
        <% if @automation.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">Please fix the following errors:</h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @automation.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Basic Information -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :name, 
                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                placeholder: "e.g., Welcome Series, Abandoned Cart" %>
            <p class="mt-1 text-xs text-gray-500">A descriptive name for this automation</p>
          </div>

          <div>
            <%= form.label :trigger_type, "Trigger", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :trigger_type, 
                options_for_select([
                  ['Contact Created', 'contact_created'],
                  ['Contact Tagged', 'contact_tagged'],
                  ['Campaign Opened', 'campaign_opened'],
                  ['Campaign Clicked', 'campaign_clicked'],
                  ['Date Based', 'date_based'],
                  ['Manual', 'manual']
                ]),
                { prompt: "Select a trigger" },
                { class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
            <p class="mt-1 text-xs text-gray-500">What will start this automation</p>
          </div>
        </div>

        <!-- Description -->
        <div>
          <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :description, 
              rows: 3,
              class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
              placeholder: "Describe the purpose and flow of this automation..." %>
          <p class="mt-1 text-xs text-gray-500">Optional description of this automation</p>
        </div>

        <!-- Trigger Conditions -->
        <div>
          <%= form.label :trigger_conditions, "Trigger Conditions", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :trigger_conditions, 
              rows: 3,
              class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
              placeholder: "JSON object with trigger conditions (optional)" %>
          <p class="mt-1 text-xs text-gray-500">Advanced trigger conditions in JSON format</p>
        </div>

        <!-- A/B Testing -->
        <div>
          <div class="flex items-center">
            <%= form.check_box :ab_test_enabled, 
                class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
            <%= form.label :ab_test_enabled, "Enable A/B Testing", class: "ml-2 block text-sm text-gray-900" %>
          </div>
          <p class="mt-1 text-xs text-gray-500">Test different variations of this automation</p>
          
          <div class="mt-3" data-controller="ab-test-options" data-ab-test-options-enabled-value="false">
            <%= form.label :ab_test_split_percentage, "Test Split Percentage", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :ab_test_split_percentage, 
                in: 10..90, step: 10, value: 50,
                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm disabled:bg-gray-100",
                disabled: true,
                data: { ab_test_options_target: "splitField" } %>
            <p class="mt-1 text-xs text-gray-500">Percentage of contacts that will receive the test variation</p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end space-x-3 pt-6 border-t border-gray-200">
          <%= link_to "Cancel", automations_path, 
              class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          
          <%= form.submit "Create Automation", 
              class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Next Steps Info -->
  <div class="mt-8 bg-blue-50 rounded-lg p-6">
    <h3 class="text-lg font-medium text-blue-900 mb-4">📋 Next Steps</h3>
    <p class="text-sm text-blue-800 mb-4">
      After creating your automation, you'll be able to:
    </p>
    <ul class="text-sm text-blue-800 space-y-2">
      <li class="flex items-start">
        <svg class="flex-shrink-0 h-4 w-4 text-blue-500 mt-0.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Add email steps to your automation sequence
      </li>
      <li class="flex items-start">
        <svg class="flex-shrink-0 h-4 w-4 text-blue-500 mt-0.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Set delays and conditions between steps
      </li>
      <li class="flex items-start">
        <svg class="flex-shrink-0 h-4 w-4 text-blue-500 mt-0.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Test your automation before activating
      </li>
      <li class="flex items-start">
        <svg class="flex-shrink-0 h-4 w-4 text-blue-500 mt-0.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Monitor performance and analytics
      </li>
    </ul>
  </div>
</div>

<script>
// Stimulus controller for A/B test options
class AbTestOptionsController extends Stimulus.Controller {
  static targets = ["splitField"]
  static values = { enabled: Boolean }
  
  connect() {
    this.toggleSplitField();
  }
  
  enabledValueChanged() {
    this.toggleSplitField();
  }
  
  toggleSplitField() {
    const checkbox = this.element.querySelector('input[type="checkbox"]');
    checkbox.addEventListener('change', () => {
      this.enabledValue = checkbox.checked;
    });
    
    this.splitFieldTarget.disabled = !this.enabledValue;
    if (this.enabledValue) {
      this.splitFieldTarget.classList.remove('bg-gray-100');
    } else {
      this.splitFieldTarget.classList.add('bg-gray-100');
    }
  }
}

Stimulus.register("ab-test-options", AbTestOptionsController);
</script>