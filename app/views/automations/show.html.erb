<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <div class="flex items-center">
        <%= link_to automations_path, class: "text-indigo-600 hover:text-indigo-800 flex items-center mr-4" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Automations
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mt-2"><%= @automation.name %></h1>
      <% if @automation.description.present? %>
        <p class="text-gray-600 mt-1"><%= @automation.description %></p>
      <% end %>
    </div>
    
    <div class="flex items-center space-x-3">
      <% if @automation.can_be_activated? %>
        <%= link_to activate_automation_path(@automation), method: :post, class: "btn btn-success flex items-center" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
          Activate
        <% end %>
      <% end %>
      
      <% if @automation.can_be_paused? %>
        <%= link_to pause_automation_path(@automation), method: :post, class: "btn btn-warning flex items-center" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          Pause
        <% end %>
      <% end %>
      
      <%= link_to edit_automation_path(@automation), class: "btn btn-primary flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
        </svg>
        Edit
      <% end %>
      
      <%= link_to duplicate_automation_path(@automation), method: :post, class: "btn btn-secondary flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path d="M7 9a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H9a2 2 0 01-2-2V9z" />
          <path d="M5 3a2 2 0 00-2 2v6a2 2 0 002 2V5h8a2 2 0 00-2-2H5z" />
        </svg>
        Duplicate
      <% end %>
      
      <%= link_to automation_path(@automation), method: :delete, data: { confirm: "Are you sure you want to delete this automation? This action cannot be undone." }, class: "btn btn-danger flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Automation Details</h2>
      <dl>
        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% status_class = case @automation.status 
                             when "draft" then "bg-gray-100 text-gray-800"
                             when "active" then "bg-green-100 text-green-800"
                             when "paused" then "bg-yellow-100 text-yellow-800"
                             when "archived" then "bg-red-100 text-red-800"
                             end %>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
              <%= @automation.status.capitalize %>
            </span>
          </dd>
        </div>
        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="text-sm font-medium text-gray-500">Trigger Type</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= @automation.trigger_type.humanize %>
          </dd>
        </div>
        <% if @automation.trigger_conditions.present? && @automation.trigger_conditions.any? %>
          <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium text-gray-500">Trigger Conditions</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <% case @automation.trigger_type %>
              <% when "contact_inactive" %>
                After <%= @automation.trigger_conditions["inactive_days"] %> days inactive
              <% when "cart_abandoned" %>
                Cart value >= <%= number_to_currency(@automation.trigger_conditions["cart_value_min"]) %>
                <% if @automation.trigger_conditions["abandoned_hours"].present? %>
                  <br>Abandoned for <%= @automation.trigger_conditions["abandoned_hours"] %> hours
                <% end %>
              <% when "tag_added" %>
                Tags: <%= @automation.trigger_conditions["tag_names"].join(", ") %>
              <% end %>
            </dd>
          </div>
        <% end %>
        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="text-sm font-medium text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= @automation.created_at.strftime("%B %d, %Y at %H:%M") %>
          </dd>
        </div>
        <% if @automation.active? && @automation.activated_at.present? %>
          <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium text-gray-500">Activated</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= @automation.activated_at.strftime("%B %d, %Y at %H:%M") %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Performance Overview</h2>
      <div class="space-y-4">
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="text-sm font-medium text-gray-700">Total Enrollments</span>
            <span class="text-sm text-gray-900 font-semibold"><%= @automation.total_enrollments %></span>
          </div>
        </div>
        
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="text-sm font-medium text-gray-700">Active Enrollments</span>
            <span class="text-sm text-gray-900 font-semibold"><%= @automation.active_enrollments %></span>
          </div>
        </div>
        
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="text-sm font-medium text-gray-700">Completion Rate</span>
            <span class="text-sm text-gray-900 font-semibold"><%= @automation.completion_rate %>%</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-2.5">
            <div class="bg-indigo-600 h-2.5 rounded-full" style="width: <%= @automation.completion_rate %>%"></div>
          </div>
        </div>
        
        <div>
          <div class="flex justify-between items-center mb-1">
            <span class="text-sm font-medium text-gray-700">Average Completion Time</span>
            <span class="text-sm text-gray-900 font-semibold">
              <% if @automation.average_completion_time > 0 %>
                <%= @automation.average_completion_time %> days
              <% else %>
                N/A
              <% end %>
            </span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Analytics</h2>
      <div id="automation-analytics" class="space-y-4">
        <% @analytics.each do |metric, value| %>
          <div>
            <div class="flex justify-between items-center mb-1">
              <span class="text-sm font-medium text-gray-700"><%= metric.to_s.humanize %></span>
              <span class="text-sm text-gray-900 font-semibold">
                <% if value.is_a?(Float) || value.is_a?(BigDecimal) %>
                  <%= number_to_percentage(value, precision: 2) %>
                <% else %>
                  <%= value %>
                <% end %>
              </span>
            </div>
            <% if value.is_a?(Float) || value.is_a?(BigDecimal) %>
              <div class="w-full bg-gray-200 rounded-full h-2.5">
                <div class="bg-indigo-600 h-2.5 rounded-full" style="width: <%= [value, 100].min %>%"></div>
              </div>
            <% end %>
          </div>
        <% end %>
        
        <div class="mt-4 pt-4 border-t border-gray-200">
          <div class="text-center">
            <button id="view-detailed-analytics" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
              View Detailed Analytics
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="bg-white rounded-lg shadow overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-xl font-medium text-gray-900">Automation Steps</h2>
    </div>
    
    <div class="p-6">
      <% if @automation.automation_steps.empty? %>
        <div class="text-center py-8 text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <p class="mt-2 text-sm font-medium">No steps have been added to this automation</p>
          <p class="mt-1 text-xs">Edit this automation to add steps</p>
        </div>
      <% else %>
        <div class="flow-root">
          <ul class="-mb-8">
            <% @automation.automation_steps.each_with_index do |step, index| %>
              <li>
                <div class="relative pb-8">
                  <% if index < @automation.automation_steps.size - 1 %>
                    <span class="absolute top-5 left-5 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
                  <% end %>
                  <div class="relative flex items-start space-x-3">
                    <div class="relative">
                      <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center ring-8 ring-white">
                        <span class="text-indigo-800 font-semibold"><%= step.step_order %></span>
                      </div>
                    </div>
                    <div class="min-w-0 flex-1 bg-gray-50 rounded-lg p-4">
                      <div class="flex justify-between">
                        <div>
                          <div class="text-sm font-medium text-gray-900">
                            <%= step.step_type.humanize %>
                          </div>
                          <% if step.delay_amount > 0 %>
                            <div class="mt-1 text-xs text-gray-500">
                              Wait <%= step.delay_amount %> <%= step.delay_unit %>
                            </div>
                          <% end %>
                        </div>
                        <div class="text-xs text-gray-500">
                          <% if step.step_type == 'email' && step.email_template_id.present? %>
                            Template: <%= step.email_template.name rescue "Unknown" %>
                          <% end %>
                        </div>
                      </div>
                      
                      <% if step.step_type == 'email' && step.custom_subject.present? %>
                        <div class="mt-2">
                          <p class="text-sm text-gray-700 font-semibold">
                            <%= step.custom_subject %>
                          </p>
                        </div>
                      <% end %>
                      
                      <% if step.conditions.present? && step.conditions.any? %>
                        <div class="mt-2 text-xs text-gray-500">
                          <div class="font-medium">Conditions:</div>
                          <ul class="list-disc list-inside">
                            <% step.conditions.each do |key, value| %>
                              <li><%= key.humanize %>: <%= value %></li>
                            <% end %>
                          </ul>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
      <h2 class="text-xl font-medium text-gray-900">Recent Enrollments</h2>
      <a href="#" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">View All</a>
    </div>
    
    <div class="overflow-x-auto">
      <% if @enrollments.empty? %>
        <div class="text-center py-8 text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <p class="mt-2 text-sm font-medium">No contacts have been enrolled yet</p>
          <p class="mt-1 text-xs">Contacts will appear here when they enter this automation</p>
        </div>
      <% else %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Contact
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Current Step
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Progress
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Enrolled
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @enrollments.each do |enrollment| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div>
                      <div class="text-sm font-medium text-gray-900">
                        <%= enrollment.contact.first_name %> <%= enrollment.contact.last_name %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= enrollment.contact.email %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% status_class = case enrollment.status 
                                    when "active" then "bg-green-100 text-green-800"
                                    when "completed" then "bg-blue-100 text-blue-800"
                                    when "paused" then "bg-yellow-100 text-yellow-800"
                                    when "dropped" then "bg-red-100 text-red-800"
                                    end %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                    <%= enrollment.status.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  Step <%= enrollment.current_step %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="w-full bg-gray-200 rounded-full h-2.5">
                    <div class="bg-indigo-600 h-2.5 rounded-full" style="width: <%= enrollment.progress_percentage %>%"></div>
                  </div>
                  <div class="text-xs text-gray-500 mt-1">
                    <%= enrollment.progress_percentage %>% complete
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= time_ago_in_words(enrollment.enrolled_at) %> ago
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>

<%= javascript_tag do %>
  document.addEventListener('DOMContentLoaded', function() {
    const viewDetailedAnalyticsBtn = document.getElementById('view-detailed-analytics');
    
    if (viewDetailedAnalyticsBtn) {
      viewDetailedAnalyticsBtn.addEventListener('click', function() {
        fetch('<%= analytics_automation_path(@automation) %>', {
          headers: {
            'Accept': 'text/html'
          }
        })
        .then(response => response.text())
        .then(html => {
          const modal = document.createElement('div');
          modal.className = 'fixed inset-0 overflow-y-auto z-50 flex items-center justify-center';
          modal.innerHTML = `
            <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"></div>
            <div class="relative bg-white rounded-lg max-w-4xl w-full max-h-screen overflow-y-auto">
              <div class="absolute top-0 right-0 pt-4 pr-4">
                <button id="close-modal" class="text-gray-400 hover:text-gray-500">
                  <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              <div class="p-6">${html}</div>
            </div>
          `;
          
          document.body.appendChild(modal);
          
          document.getElementById('close-modal').addEventListener('click', function() {
            document.body.removeChild(modal);
          });
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while loading analytics data.');
        });
      });
    }
  });
<% end %>
