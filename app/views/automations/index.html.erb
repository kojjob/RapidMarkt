<div class="container mx-auto px-4 py-8">
  <header class="mb-8">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900">Email Automations</h1>
      <div class="flex space-x-3">
        <%= link_to new_automation_path, class: "btn btn-primary flex items-center" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          New Automation
        <% end %>
        <div class="dropdown relative" data-controller="dropdown">
          <button data-action="dropdown#toggle" class="btn btn-secondary flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z" />
            </svg>
            Actions
          </button>
          <div data-dropdown-target="menu" class="dropdown-menu hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg z-10">
            <div class="py-1">
              <a href="#" class="bulk-action-btn" data-action="activate">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                </svg>
                Activate Selected
              </a>
              <a href="#" class="bulk-action-btn" data-action="pause">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                Pause Selected
              </a>
              <a href="#" class="bulk-action-btn text-red-600" data-action="delete">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                Delete Selected
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-4 flex flex-col sm:flex-row gap-4">
      <div class="flex-1">
        <form action="<%= automations_path %>" method="get" class="flex">
          <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
              </svg>
            </div>
            <input type="text" name="search" value="<%= params[:search] %>" placeholder="Search automations..." class="form-input pl-10 py-2 block w-full sm:text-sm border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <button type="submit" class="ml-2 btn btn-secondary">Search</button>
        </form>
      </div>
      <div class="flex-shrink-0 flex items-center">
        <label for="status_filter" class="mr-2 text-sm font-medium text-gray-700">Status:</label>
        <select id="status_filter" name="status" class="form-select py-2 pl-3 pr-10 text-base border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" onchange="window.location.href='<%= automations_path %>?status=' + this.value">
          <option value="">All</option>
          <option value="draft" <%= params[:status] == 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="active" <%= params[:status] == 'active' ? 'selected' : '' %>>Active</option>
          <option value="paused" <%= params[:status] == 'paused' ? 'selected' : '' %>>Paused</option>
          <option value="archived" <%= params[:status] == 'archived' ? 'selected' : '' %>>Archived</option>
        </select>
      </div>
    </div>
  </header>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <form id="bulk-actions-form">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <div class="flex items-center">
                <input type="checkbox" id="select-all" class="form-checkbox h-4 w-4 text-indigo-600 rounded border-gray-300">
                <span class="ml-2">Name</span>
              </div>
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Trigger
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Status
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Performance
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Created
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @automations.empty? %>
            <tr>
              <td colspan="6" class="px-6 py-10 text-center text-gray-500">
                <div class="flex flex-col items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  <p class="text-lg font-medium mb-1">No automations found</p>
                  <p class="text-sm mb-4">Get started by creating your first email automation</p>
                  <%= link_to "Create Automation", new_automation_path, class: "btn btn-primary" %>
                </div>
              </td>
            </tr>
          <% else %>
            <% @automations.each do |automation| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <input type="checkbox" name="automation_ids[]" value="<%= automation.id %>" class="automation-checkbox form-checkbox h-4 w-4 text-indigo-600 rounded border-gray-300">
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= link_to automation.name, automation_path(automation), class: "hover:text-indigo-600" %>
                      </div>
                      <% if automation.description.present? %>
                        <div class="text-sm text-gray-500 truncate max-w-xs">
                          <%= automation.description %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= automation.trigger_type.humanize %>
                  </div>
                  <% if automation.trigger_conditions.present? && automation.trigger_conditions.any? %>
                    <div class="text-xs text-gray-500">
                      <% case automation.trigger_type %>
                      <% when "contact_inactive" %>
                        After <%= automation.trigger_conditions["inactive_days"] %> days inactive
                      <% when "cart_abandoned" %>
                        Cart value >= <%= automation.trigger_conditions["cart_value_min"] %>
                      <% when "tag_added" %>
                        Tags: <%= automation.trigger_conditions["tag_names"].join(", ") %>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% status_class = case automation.status 
                                    when "draft" then "bg-gray-100 text-gray-800"
                                    when "active" then "bg-green-100 text-green-800"
                                    when "paused" then "bg-yellow-100 text-yellow-800"
                                    when "archived" then "bg-red-100 text-red-800"
                                    end %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                    <%= automation.status.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col">
                    <div class="text-sm text-gray-900 mb-1">
                      <%= automation.total_enrollments %> enrollments
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                      <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= automation.completion_rate %>%"></div>
                    </div>
                    <div class="text-xs text-gray-500 mt-1">
                      <%= automation.completion_rate %>% completion rate
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= time_ago_in_words(automation.created_at) %> ago
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <% if automation.can_be_activated? %>
                      <%= link_to activate_automation_path(automation), method: :post, class: "text-green-600 hover:text-green-900", title: "Activate" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                        </svg>
                      <% end %>
                    <% end %>
                    
                    <% if automation.can_be_paused? %>
                      <%= link_to pause_automation_path(automation), method: :post, class: "text-yellow-600 hover:text-yellow-900", title: "Pause" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                      <% end %>
                    <% end %>
                    
                    <%= link_to edit_automation_path(automation), class: "text-indigo-600 hover:text-indigo-900", title: "Edit" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                      </svg>
                    <% end %>
                    
                    <%= link_to duplicate_automation_path(automation), method: :post, class: "text-blue-600 hover:text-blue-900", title: "Duplicate" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M7 9a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H9a2 2 0 01-2-2V9z" />
                        <path d="M5 3a2 2 0 00-2 2v6a2 2 0 002 2V5h8a2 2 0 00-2-2H5z" />
                      </svg>
                    <% end %>
                    
                    <%= link_to automation_path(automation), method: :delete, data: { confirm: "Are you sure you want to delete this automation?" }, class: "text-red-600 hover:text-red-900", title: "Delete" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </form>
  </div>
</div>

<%= javascript_tag do %>
  document.addEventListener('DOMContentLoaded', function() {
    // Select all functionality
    const selectAllCheckbox = document.getElementById('select-all');
    const automationCheckboxes = document.querySelectorAll('.automation-checkbox');
    
    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener('change', function() {
        automationCheckboxes.forEach(checkbox => {
          checkbox.checked = selectAllCheckbox.checked;
        });
      });
    }
    
    // Bulk actions
    const bulkActionButtons = document.querySelectorAll('.bulk-action-btn');
    const bulkActionsForm = document.getElementById('bulk-actions-form');
    
    bulkActionButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        
        const action = this.getAttribute('data-action');
        const checkedAutomations = Array.from(document.querySelectorAll('.automation-checkbox:checked'));
        
        if (checkedAutomations.length === 0) {
          alert('Please select at least one automation.');
          return;
        }
        
        if (action === 'delete' && !confirm('Are you sure you want to delete the selected automations? This action cannot be undone.')) {
          return;
        }
        
        const automationIds = checkedAutomations.map(checkbox => checkbox.value);
        
        fetch('<%= bulk_action_automations_path %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({
            automation_ids: automationIds,
            bulk_action: action
          })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('Error: ' + data.message);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while processing your request.');
        });
      });
    });
  });
<% end %>
