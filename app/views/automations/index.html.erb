<!-- Modern Automations Container -->
<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50">
  <div class="px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section -->
    <div class="mb-8">
      <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl border border-white/20 overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 px-8 py-12">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <h1 class="text-3xl font-bold text-white">Automations</h1>
                <p class="text-blue-100 mt-2">Create powerful email workflows and sequences to engage your audience</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="bg-white/90 backdrop-blur-sm px-8 py-6 border-t border-gray-100">
          <div class="flex flex-wrap gap-3">
            <span class="text-sm font-medium text-gray-600 flex items-center">
              <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              Quick Actions:
            </span>
            <%= link_to templates_path, 
                class: "inline-flex items-center px-4 py-2 rounded-xl text-sm font-medium text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm hover:shadow-md transition-all duration-200" do %>
              <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              Browse Templates
            <% end %>
            <%= link_to new_automation_path, 
                class: "inline-flex items-center px-6 py-2 rounded-xl text-sm font-medium text-white bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-lg hover:shadow-xl transition-all duration-200" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Create Automation
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-lg border border-white/20 p-6 mb-8">
      <%= form_with url: automations_path, method: :get, local: true, class: "space-y-6" do |form| %>
        <div class="flex items-center space-x-2 mb-4">
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <h3 class="text-lg font-semibold text-gray-900">Search & Filter Automations</h3>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="space-y-2">
            <%= form.label :search, "Search automations", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :search, 
                value: params[:search], 
                placeholder: "Search by name, description...", 
                class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm hover:shadow-md transition-all duration-200" %>
          </div>
          
          <div class="space-y-2">
            <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :status, 
                options_for_select([['All Statuses', ''], ['Active', 'active'], ['Paused', 'paused'], ['Draft', 'draft']], params[:status]), 
                {}, 
                { class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm hover:shadow-md transition-all duration-200" } %>
          </div>
          
          <div class="space-y-2">
            <%= form.label :sort, "Sort by", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :sort, 
                options_for_select([['Recently Created', 'created_desc'], ['Oldest First', 'created_asc'], ['Name A-Z', 'name_asc'], ['Name Z-A', 'name_desc']], params[:sort]), 
                {}, 
                { class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm hover:shadow-md transition-all duration-200" } %>
          </div>
        </div>
        
        <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-200">
          <%= form.submit "Apply Filters", class: "inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-lg hover:shadow-xl transition-all duration-200" %>
          <%= link_to automations_path, 
              class: "inline-flex items-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm hover:shadow-md transition-all duration-200" do %>
            <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Clear Filters
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Bulk Actions Section -->
    <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-lg border border-white/20 p-6 mb-8">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <h3 class="text-lg font-semibold text-gray-900">Bulk Actions</h3>
        </div>
        
        <div class="dropdown relative" data-controller="dropdown">
          <button data-action="dropdown#toggle" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm hover:shadow-md transition-all duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z" />
            </svg>
            Actions
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div data-dropdown-target="menu" class="dropdown-menu hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-gray-200 z-10">
            <div class="py-2">
              <a href="#" class="bulk-action-btn flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors duration-200" data-action="activate">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-3 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                </svg>
                Activate Selected
              </a>
              <a href="#" class="bulk-action-btn flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors duration-200" data-action="pause">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-3 text-yellow-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                Pause Selected
              </a>
              <div class="border-t border-gray-100 my-1"></div>
              <a href="#" class="bulk-action-btn flex items-center px-4 py-3 text-sm text-red-600 hover:bg-red-50 transition-colors duration-200" data-action="delete">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-3" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                Delete Selected
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Automations Grid -->
    <div class="space-y-6">
      <% if @automations.any? %>
        <form id="bulk-actions-form">
          <div class="grid grid-cols-1 gap-6">
            <% @automations.each do |automation| %>
              <div class="group bg-white/90 backdrop-blur-sm rounded-2xl shadow-lg border border-white/20 hover:shadow-xl transition-all duration-300 overflow-hidden">
                <!-- Automation Header -->
                <div class="bg-gradient-to-r from-blue-100 to-indigo-100 px-6 py-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                      <input type="checkbox" name="automation_ids[]" value="<%= automation.id %>" class="automation-checkbox rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50">
                      <div class="bg-white/80 backdrop-blur-sm rounded-xl p-3">
                        <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                      </div>
                      <div>
                        <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                          <%= link_to automation.name, automation_path(automation) %>
                        </h3>
                        <p class="text-sm text-gray-600">
                          <%= automation.description.present? ? truncate(automation.description, length: 80) : "No description provided" %>
                        </p>
                      </div>
                    </div>
                    
                    <div class="flex items-center space-x-3">
                      <% status_class = case automation.status 
                                        when "draft" then "bg-gray-100 text-gray-800"
                                        when "active" then "bg-green-100 text-green-800"
                                        when "paused" then "bg-yellow-100 text-yellow-800"
                                        when "archived" then "bg-red-100 text-red-800"
                                        end %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= status_class %>">
                        <%= automation.status.humanize %>
                      </span>
                      
                      <div class="relative" data-controller="dropdown">
                        <button type="button"
                                class="p-2 text-gray-400 hover:text-gray-600 hover:bg-white/50 rounded-lg transition-colors"
                                data-action="click->dropdown#toggle"
                                aria-label="Automation options">
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/>
                          </svg>
                        </button>
                        <div class="origin-top-right absolute right-0 mt-2 w-56 rounded-xl shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50" 
                             data-dropdown-target="menu">
                          <div class="py-2">
                            <%= link_to automation_path(automation), 
                                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition-colors" do %>
                              <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                              </svg>
                              View Details
                            <% end %>
                            <%= link_to edit_automation_path(automation), 
                                class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition-colors" do %>
                              <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                              </svg>
                              Edit Automation
                            <% end %>
                            <div class="border-t border-gray-100 my-1"></div>
                            <%= link_to automation_path(automation), method: :delete, 
                                confirm: "Are you sure you want to delete this automation?", 
                                class: "flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors" do %>
                              <svg class="w-4 h-4 mr-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                              </svg>
                              Delete Automation
                            <% end %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- Automation Stats -->
                <div class="px-6 py-4">
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="text-center">
                      <div class="text-2xl font-bold text-blue-600"><%= automation.total_enrollments || 0 %></div>
                      <div class="text-sm text-gray-500">Enrollments</div>
                    </div>
                    <div class="text-center">
                      <div class="text-2xl font-bold text-green-600"><%= automation.trigger_type&.humanize || 'Manual' %></div>
                      <div class="text-sm text-gray-500">Trigger Type</div>
                    </div>
                    <div class="text-center">
                      <div class="text-2xl font-bold text-purple-600"><%= automation.completion_rate || 0 %>%</div>
                      <div class="text-sm text-gray-500">Completion Rate</div>
                    </div>
                    <div class="text-center">
                      <div class="text-2xl font-bold text-orange-600"><%= time_ago_in_words(automation.created_at) %></div>
                      <div class="text-sm text-gray-500">Created</div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </form>
      <% else %>
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-lg border border-white/20 p-12 text-center">
          <div class="flex flex-col items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-400 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">No automations found</h3>
            <p class="text-gray-600 mb-6">Get started by creating your first email automation to engage your audience</p>
            <%= link_to new_automation_path, 
                class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-lg hover:shadow-xl transition-all duration-200" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              Create Your First Automation
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
</div>

<%= javascript_tag do %>
  document.addEventListener('DOMContentLoaded', function() {
    // Select all functionality
    const selectAllCheckbox = document.getElementById('select-all');
    const automationCheckboxes = document.querySelectorAll('.automation-checkbox');
    
    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener('change', function() {
        automationCheckboxes.forEach(checkbox => {
          checkbox.checked = selectAllCheckbox.checked;
        });
      });
    }
    
    // Bulk actions
    const bulkActionButtons = document.querySelectorAll('.bulk-action-btn');
    const bulkActionsForm = document.getElementById('bulk-actions-form');
    
    bulkActionButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        
        const action = this.getAttribute('data-action');
        const checkedAutomations = Array.from(document.querySelectorAll('.automation-checkbox:checked'));
        
        if (checkedAutomations.length === 0) {
          alert('Please select at least one automation.');
          return;
        }
        
        if (action === 'delete' && !confirm('Are you sure you want to delete the selected automations? This action cannot be undone.')) {
          return;
        }
        
        const automationIds = checkedAutomations.map(checkbox => checkbox.value);
        
        fetch('<%= bulk_action_automations_path %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({
            automation_ids: automationIds,
            bulk_action: action
          })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('Error: ' + data.message);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while processing your request.');
        });
      });
    });
  });
<% end %>
