<% content_for :title, "Campaigns - RapidMarkt" %>

<!-- Modern Campaigns Container -->
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-emerald-50 to-cyan-50">
  <!-- Header Section -->
  <div class="bg-white/90 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-20">
    <div class="px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <div class="flex-1 min-w-0">
          <div class="flex items-center">
            <div class="w-12 h-12 bg-gradient-to-br from-emerald-100 to-cyan-100 rounded-xl flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 7.89a2 2 0 002.83 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
                Email Campaigns
              </h1>
              <p class="mt-1 text-lg text-gray-600">
                Create, manage and track your email marketing campaigns with ease.
              </p>
            </div>
            <div class="ml-6 hidden lg:block">
              <div class="flex items-center space-x-2">
                <div class="h-2 w-2 bg-green-400 rounded-full animate-pulse"></div>
                <span class="text-sm text-gray-500">Live analytics</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="mt-6 sm:mt-0 flex flex-col sm:flex-row sm:items-center space-y-3 sm:space-y-0 sm:space-x-3">
          <%= link_to templates_path, 
              class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Browse Templates
          <% end %>
          
          <%= link_to new_campaign_path, 
              class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-gradient-to-r from-emerald-500 to-cyan-600 hover:from-emerald-600 hover:to-cyan-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Create Campaign
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="px-4 sm:px-6 lg:px-8 py-8">
    <!-- Search and Filters -->
    <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 p-6 mb-8">
      <div class="flex items-center mb-4">
        <svg class="w-5 h-5 text-emerald-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.707A1 1 0 013 7V4z"/>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900">Filter & Search</h3>
      </div>
      
      <%= form_with url: campaigns_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-3 gap-4" do |form| %>
        <div>
          <%= form.label :search, "Search campaigns", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <%= form.text_field :search, value: params[:search], 
                placeholder: "Search by name or subject...",
                class: "pl-10 block w-full border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-sm" %>
          </div>
        </div>
        
        <div>
          <%= form.label :status, "Campaign Status", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.select :status, 
              options_for_select([
                ['All Statuses', ''],
                ['Draft', 'draft'],
                ['Scheduled', 'scheduled'],
                ['Sending', 'sending'],
                ['Sent', 'sent']
              ], params[:status]),
              {},
              { class: "block w-full border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-sm" } %>
        </div>
        
        <div class="flex items-end space-x-3">
          <%= form.submit "Apply Filters", 
              class: "flex-1 px-4 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-emerald-600 hover:bg-emerald-700 focus:ring-2 focus:ring-emerald-500 transition-all" %>
          
          <% if params[:search].present? || params[:status].present? %>
            <%= link_to "Clear", campaigns_path, 
                class: "px-4 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 transition-all" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Campaigns Grid -->
    <% if @campaigns.any? %>
      <!-- Bulk Actions Bar -->
      <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 p-4 mb-6" data-controller="bulk-actions">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0">
          <div class="flex items-center space-x-4">
            <label class="flex items-center group cursor-pointer">
              <input type="checkbox" data-action="change->bulk-actions#toggleAll" data-bulk-actions-target="selectAll" 
                     class="rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 transition-all">
              <span class="ml-3 text-sm font-medium text-gray-700">Select All</span>
            </label>
            <div class="h-4 w-px bg-gray-300"></div>
            <span class="text-sm text-gray-500 font-medium" data-bulk-actions-target="selectedCount">0 selected</span>
          </div>
          
          <div class="flex items-center space-x-3" data-bulk-actions-target="actions" style="display: none;">
            <button type="button" data-bulk-actions-target="sendButton"
                    class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 transition-all">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
              Send Selected
            </button>
            <button type="button" data-bulk-actions-target="scheduleButton"
                    class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-all">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Schedule
            </button>
          </div>
        </div>
      </div>

      <!-- Campaigns Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
        <% @campaigns.each do |campaign| %>
          <div class="group bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 hover:shadow-xl hover:scale-105 transition-all duration-300 overflow-hidden" data-controller="dropdown">
            <!-- Campaign Header -->
            <div class="relative bg-gradient-to-r <%= case campaign.status
                when 'draft' then 'from-gray-400 to-gray-500'
                when 'sending' then 'from-yellow-400 to-amber-500'
                when 'sent' then 'from-green-400 to-emerald-500'
                when 'scheduled' then 'from-blue-400 to-indigo-500'
                else 'from-gray-400 to-gray-500'
                end %> h-20 p-4">
              <div class="flex items-center justify-between h-full">
                <div class="flex items-center">
                  <input type="checkbox" 
                         data-action="change->bulk-actions#updateSelection" 
                         data-bulk-actions-target="campaignCheckbox" 
                         data-campaign-id="<%= campaign.id %>"
                         class="rounded border-white/50 text-white bg-white/20 focus:ring-white/50 transition-all">
                  <span class="ml-3 text-white font-semibold text-sm px-3 py-1 bg-white/20 rounded-full backdrop-blur-sm">
                    <%= campaign.status.humanize %>
                  </span>
                </div>
                
                <button type="button" 
                        data-action="click->dropdown#toggle"
                        class="p-2 text-white/80 hover:text-white hover:bg-white/20 rounded-lg transition-all">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Campaign Content -->
            <div class="p-6">
              <div class="mb-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-emerald-600 transition-colors">
                  <%= link_to campaign.name, campaign_path(campaign) %>
                </h3>
                <p class="text-sm text-gray-600 line-clamp-2">
                  <span class="font-medium">Subject:</span> <%= campaign.subject %>
                </p>
              </div>

              <!-- Campaign Stats -->
              <% if campaign.sent? %>
                <div class="grid grid-cols-2 gap-3 mb-4">
                  <div class="bg-green-50 rounded-lg p-3 text-center">
                    <div class="text-lg font-bold text-green-600">
                      <%= number_with_delimiter(campaign.campaign_contacts.where.not(sent_at: nil).count) %>
                    </div>
                    <div class="text-xs text-green-700">Sent</div>
                  </div>
                  <div class="bg-blue-50 rounded-lg p-3 text-center">
                    <div class="text-lg font-bold text-blue-600">
                      <%= number_with_delimiter(campaign.campaign_contacts.where.not(opened_at: nil).count) %>
                    </div>
                    <div class="text-xs text-blue-700">Opened</div>
                  </div>
                </div>
              <% end %>

              <!-- Campaign Meta -->
              <div class="flex items-center justify-between text-xs text-gray-500 mb-4">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <%= time_ago_in_words(campaign.created_at) %> ago
                </div>
                <% if campaign.scheduled_at.present? %>
                  <div class="flex items-center text-blue-600">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= campaign.scheduled_at.strftime("%b %d") %>
                  </div>
                <% elsif campaign.sent_at.present? %>
                  <div class="flex items-center text-green-600">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <%= time_ago_in_words(campaign.sent_at) %> ago
                  </div>
                <% end %>
              </div>

              <!-- Action Buttons -->
              <div class="flex space-x-2">
                <%= link_to campaign_path(campaign), 
                    class: "flex-1 inline-flex items-center justify-center px-3 py-2 border border-gray-300 text-xs font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:ring-2 focus:ring-emerald-500 transition-all" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 616 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  View
                <% end %>
                <% unless campaign.sent? %>
                  <%= link_to edit_campaign_path(campaign), 
                      class: "flex-1 inline-flex items-center justify-center px-3 py-2 border border-transparent text-xs font-medium rounded-lg text-white bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-600 hover:to-cyan-600 focus:ring-2 focus:ring-emerald-500 transition-all" do %>
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Edit
                  <% end %>
                <% end %>
              </div>
            </div>

            <!-- Dropdown Menu -->
            <div data-dropdown-target="menu" 
                 class="hidden origin-top-right absolute right-4 top-16 mt-2 w-56 rounded-xl shadow-xl bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-50">
              <div class="py-2">
                <%= link_to campaign_path(campaign), 
                    class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors" do %>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  View Details
                <% end %>
                <% unless campaign.sent? %>
                  <%= link_to edit_campaign_path(campaign), 
                      class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition-colors" do %>
                    <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Edit Campaign
                  <% end %>
                <% end %>
                <%= link_to preview_campaign_path(campaign), 
                    target: "_blank",
                    class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700 transition-colors" do %>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  Preview Email
                <% end %>
                <% if campaign.draft? %>
                  <%= link_to send_test_campaign_path(campaign), 
                      data: { turbo_method: :post },
                      class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-yellow-50 hover:text-yellow-700 transition-colors" do %>
                    <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 7.89a2 2 0 002.83 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Send Test
                  <% end %>
                <% end %>
                <%= link_to new_campaign_path(duplicate: campaign.id), 
                    class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors" do %>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  Duplicate
                <% end %>
                <% unless campaign.sent? %>
                  <div class="border-t border-gray-100 my-1"></div>
                  <%= link_to campaign_path(campaign), 
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this campaign?" },
                      class: "flex items-center px-4 py-2 text-sm text-red-700 hover:bg-red-50 transition-colors" do %>
                    <svg class="w-4 h-4 mr-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete Campaign
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Pagination -->
      <% if @campaigns.respond_to?(:total_pages) && @campaigns.total_pages > 1 %>
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 mt-8 p-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-4 sm:space-y-0">
            <div class="text-sm text-gray-600">
              Showing <span class="font-semibold text-gray-900"><%= (@campaigns.current_page - 1) * @campaigns.limit_value + 1 %></span>
              to <span class="font-semibold text-gray-900"><%= [@campaigns.current_page * @campaigns.limit_value, @campaigns.total_count].min %></span>
              of <span class="font-semibold text-gray-900"><%= number_with_delimiter(@campaigns.total_count) %></span> campaigns
            </div>
            
            <div class="flex items-center space-x-2">
              <% if @campaigns.prev_page %>
                <%= link_to campaigns_path(page: @campaigns.prev_page, search: params[:search], status: params[:status]), 
                    class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transition-all" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                  </svg>
                  Previous
                <% end %>
              <% end %>
              
              <% if @campaigns.next_page %>
                <%= link_to campaigns_path(page: @campaigns.next_page, search: params[:search], status: params[:status]), 
                    class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transition-all" do %>
                  Next
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 text-center py-16">
        <div class="max-w-md mx-auto">
          <div class="w-20 h-20 mx-auto bg-gradient-to-br from-emerald-100 to-cyan-100 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-10 h-10 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 7.89a2 2 0 002.83 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          
          <h3 class="text-2xl font-bold text-gray-900 mb-3">
            <% if params[:search].present? || params[:status].present? %>
              No campaigns found
            <% else %>
              Start your first campaign
            <% end %>
          </h3>
          
          <p class="text-lg text-gray-600 mb-8">
            <% if params[:search].present? || params[:status].present? %>
              Try adjusting your search criteria or clear filters to see all campaigns.
            <% else %>
              Create engaging email campaigns to connect with your audience and grow your business.
            <% end %>
          </p>
          
          <div class="flex flex-col sm:flex-row justify-center space-y-3 sm:space-y-0 sm:space-x-4">
            <% if params[:search].present? || params[:status].present? %>
              <%= link_to campaigns_path, 
                  class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transition-all" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Clear Filters
              <% end %>
            <% else %>
              <%= link_to templates_path, 
                  class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transition-all" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Browse Templates
              <% end %>
              <%= link_to new_campaign_path, 
                  class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-gradient-to-r from-emerald-500 to-cyan-600 hover:from-emerald-600 hover:to-cyan-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Create Campaign
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Stimulus Controller for Bulk Actions -->
<script>
class BulkActionsController extends Stimulus.Controller {
  static targets = ["selectAll", "campaignCheckbox", "selectedCount", "actions", "sendButton", "scheduleButton"]
  
  connect() {
    this.updateUI()
  }
  
  toggleAll() {
    const isChecked = this.selectAllTarget.checked
    this.campaignCheckboxTargets.forEach(checkbox => {
      checkbox.checked = isChecked
    })
    this.updateUI()
  }
  
  updateSelection() {
    const checkedBoxes = this.campaignCheckboxTargets.filter(cb => cb.checked)
    const allBoxes = this.campaignCheckboxTargets
    
    this.selectAllTarget.checked = checkedBoxes.length === allBoxes.length
    this.selectAllTarget.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < allBoxes.length
    
    this.updateUI()
  }
  
  updateUI() {
    const checkedBoxes = this.campaignCheckboxTargets.filter(cb => cb.checked)
    const count = checkedBoxes.length
    
    this.selectedCountTarget.textContent = `${count} selected`
    
    if (count > 0) {
      this.actionsTarget.style.display = 'flex'
    } else {
      this.actionsTarget.style.display = 'none'
    }
  }
}

Stimulus.register("bulk-actions", BulkActionsController)
</script>