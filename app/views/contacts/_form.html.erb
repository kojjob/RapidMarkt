<!-- Contact Form Container -->
<!-- Modern Form Container -->
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white/80 backdrop-blur-sm shadow-xl rounded-2xl border border-gray-200 overflow-hidden">
      
      <!-- Error Messages -->
      <% if contact.errors.any? %>
        <div class="bg-gradient-to-r from-red-50 to-pink-50 border-l-4 border-red-400 p-6 m-6 rounded-2xl shadow-sm">
          <div class="flex">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-r from-red-500 to-pink-600 rounded-xl flex items-center justify-center shadow-lg">
                <svg class="h-6 w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
            <div class="ml-4 flex-1">
              <h3 class="text-lg font-semibold text-red-800 mb-2">
                Form Validation Errors
              </h3>
              <div class="text-sm text-red-700 mb-4">
                <p class="mb-2">There <%= contact.errors.count == 1 ? 'was' : 'were' %> <%= pluralize(contact.errors.count, "error") %> with your submission:</p>
                <ul role="list" class="list-disc pl-5 space-y-1">
                  <% contact.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%= form_with model: contact, local: true, class: "contact-form" do |form| %>

        <!-- Header Section -->
        <div class="bg-gradient-to-r from-indigo-500 to-purple-600 px-8 py-8">
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-4 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h1 class="text-3xl font-bold text-white mb-2">
              <%= contact.persisted? ? 'Edit Contact' : 'Add New Contact' %>
            </h1>
            <p class="text-indigo-100">Enter the contact details to build your audience</p>
          </div>
        </div>

        <!-- Contact Information Section -->
        <div class="p-8">
          <div class="max-w-3xl mx-auto">
            <!-- Basic Information Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-8">
              <div class="flex items-center mb-6">
                <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mr-4">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Basic Information</h3>
                  <p class="text-gray-600">Essential contact details</p>
                </div>
              </div>

              <div class="space-y-6">
                <!-- Name Fields -->
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                  <div>
                    <%= form.label :first_name, "First Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
                    <%= form.text_field :first_name,
                        placeholder: "e.g., John",
                        required: true,
                        class: "block w-full px-4 py-3 border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all duration-200 hover:border-gray-400 hover:shadow-md" %>
                  </div>

                  <div>
                    <%= form.label :last_name, "Last Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
                    <%= form.text_field :last_name,
                        placeholder: "e.g., Doe",
                        required: true,
                        class: "block w-full px-4 py-3 border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all duration-200 hover:border-gray-400 hover:shadow-md" %>
                  </div>
                </div>

                <!-- Email Field -->
                <div>
                  <%= form.label :email, "Email Address", class: "block text-sm font-semibold text-gray-700 mb-2" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                      </svg>
                    </div>
                    <%= form.email_field :email,
                        placeholder: "john.doe@example.com",
                        required: true,
                        class: "block w-full pl-10 pr-4 py-3 border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all duration-200 hover:border-gray-400 hover:shadow-md" %>
                  </div>
                  <p class="mt-2 text-xs text-gray-500 flex items-center">
                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    This email will be used for campaign delivery
                  </p>
                </div>

                <!-- Status Field -->
                <div>
                  <%= form.label :status, "Subscription Status", class: "block text-sm font-semibold text-gray-700 mb-2" %>
                  <%= form.select :status,
                      options_for_select([
                        ['Subscribed', 'subscribed'],
                        ['Unsubscribed', 'unsubscribed']
                      ], contact.status),
                      {},
                      { class: "block w-full px-4 py-3 border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all duration-200 hover:border-gray-400 hover:shadow-md" } %>
                  <p class="mt-2 text-xs text-gray-500 flex items-center">
                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Only subscribed contacts receive campaigns
                  </p>
                </div>
              </div>
            </div>

            <!-- Tags Section -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
              <div class="flex items-center mb-6">
                <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center mr-4">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Tags & Organization</h3>
                  <p class="text-gray-600">Organize contacts for better targeting</p>
                </div>
              </div>

              <div class="space-y-6">
                <!-- Existing Tags -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-3">Select existing tags</label>
                  <div class="bg-gray-50 rounded-xl p-4 max-h-48 overflow-y-auto border border-gray-200">
                    <% if @current_account.tags.any? %>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <% @current_account.tags.order(:name).each do |tag| %>
                          <label class="flex items-center p-3 bg-white rounded-lg border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50 transition-all duration-200 cursor-pointer">
                            <%= check_box_tag "contact[tag_ids][]", tag.id, 
                                contact.tag_ids.include?(tag.id),
                                class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
                            <span class="ml-3 text-sm font-medium text-gray-700"><%= tag.name %></span>
                          </label>
                        <% end %>
                      </div>
                    <% else %>
                      <div class="text-center py-8">
                        <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                        </svg>
                        <p class="text-sm text-gray-500">No tags available yet</p>
                        <p class="text-xs text-gray-400 mt-1">Create your first tag below to organize contacts</p>
                      </div>
                    <% end %>
                  </div>
                </div>
                
                <!-- New Tags -->
                <div>
                  <%= form.label :new_tags, "Create new tags", class: "block text-sm font-semibold text-gray-700 mb-2" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                      </svg>
                    </div>
                    <%= form.text_field :new_tags, 
                        class: "block w-full pl-10 pr-4 py-3 border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all duration-200 hover:border-gray-400 hover:shadow-md",
                        placeholder: "marketing, newsletter, vip-customer" %>
                  </div>
                  <p class="mt-2 text-xs text-gray-500 flex items-center">
                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Separate multiple tags with commas - they'll be created automatically
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="bg-gray-50 px-8 py-6 border-t border-gray-200">
          <div class="flex flex-col sm:flex-row sm:justify-end space-y-3 sm:space-y-0 sm:space-x-4">
            <%= link_to contacts_path, 
                class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              Cancel
            <% end %>
            
            <%= form.submit contact.persisted? ? "Update Contact" : "Add Contact", 
                class: "inline-flex items-center justify-center px-8 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>