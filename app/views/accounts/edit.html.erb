<div class="min-h-screen bg-gray-50">
  <div class="px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="bg-white shadow-sm rounded-lg p-6 mb-8">
      <div class="md:flex md:items-center md:justify-between">
        <div class="min-w-0 flex-1">
          <h1 class="text-3xl font-bold text-gray-900">Edit Account</h1>
          <p class="mt-2 text-sm text-gray-600">Update your account information and settings</p>
        </div>
        <div class="mt-4 md:ml-4 md:mt-0">
          <%= link_to account_path, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
            <svg class="-ml-0.5 mr-1.5 h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Account
          <% end %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Edit Form -->
      <div class="lg:col-span-2">
        <div class="bg-white shadow-sm rounded-lg">
          <div class="px-6 py-5 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900">Account Details</h3>
            <p class="mt-1 text-sm text-gray-600">Update your account information</p>
          </div>
          <div class="px-6 py-5">
            <%= form_with model: @current_account, url: account_path, method: :patch, local: true, class: "space-y-6" do |form| %>
              <% if @current_account.errors.any? %>
                <div class="rounded-md bg-red-50 p-4">
                  <div class="flex">
                    <div class="flex-shrink-0">
                      <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z" />
                      </svg>
                    </div>
                    <div class="ml-3">
                      <h3 class="text-sm font-medium text-red-800">There were errors with your submission:</h3>
                      <div class="mt-2 text-sm text-red-700">
                        <ul class="list-disc list-inside space-y-1">
                          <% @current_account.errors.full_messages.each do |message| %>
                            <li><%= message %></li>
                          <% end %>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <%= form.label :name, "Account Name", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_field :name, 
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                      placeholder: "Your Company Name" %>
                  <p class="mt-1 text-xs text-gray-500">This will be displayed in your account dashboard</p>
                </div>

                <div>
                  <%= form.label :subdomain, "Subdomain", class: "block text-sm font-medium text-gray-700" %>
                  <div class="mt-1 flex rounded-md shadow-sm">
                    <%= form.text_field :subdomain, 
                        class: "block w-full min-w-0 flex-1 rounded-none rounded-l-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                        placeholder: "yourcompany" %>
                    <span class="inline-flex items-center rounded-r-md border border-l-0 border-gray-300 bg-gray-50 px-3 text-sm text-gray-500">
                      .rapidmarkt.com
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-gray-500">Choose a unique subdomain for your account</p>
                </div>
              </div>

              <div>
                <%= form.label :plan, "Plan", class: "block text-sm font-medium text-gray-700" %>
                <%= form.select :plan, 
                    options_for_select([['Free', 'free'], ['Pro', 'pro'], ['Enterprise', 'enterprise']], @current_account.plan),
                    {},
                    { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
                <p class="mt-1 text-xs text-gray-500">Select your account plan</p>
              </div>

              <div>
                <%= form.label :status, "Account Status", class: "block text-sm font-medium text-gray-700" %>
                <%= form.select :status, 
                    options_for_select([['Active', 'active'], ['Inactive', 'inactive'], ['Suspended', 'suspended']], @current_account.status),
                    {},
                    { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
                <p class="mt-1 text-xs text-gray-500">Current status of your account</p>
              </div>

              <div class="pt-4 border-t border-gray-200">
                <div class="flex justify-end space-x-3">
                  <%= link_to account_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
                    Cancel
                  <% end %>
                  <%= form.submit "Update Account", 
                      class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Account Info -->
      <div class="lg:col-span-1">
        <div class="bg-white shadow-sm rounded-lg">
          <div class="px-6 py-5">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Current Information</h3>
            <div class="space-y-3">
              <div>
                <label class="block text-sm font-medium text-gray-700">Account ID</label>
                <p class="mt-1 text-sm text-gray-900 font-mono"><%= @current_account.id %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700">Created</label>
                <p class="mt-1 text-sm text-gray-900"><%= @current_account.created_at.strftime("%B %d, %Y") %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700">Last Updated</label>
                <p class="mt-1 text-sm text-gray-900"><%= @current_account.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700">Owner</label>
                <p class="mt-1 text-sm text-gray-900"><%= @current_account.owner&.full_name %></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700">Team Members</label>
                <p class="mt-1 text-sm text-gray-900"><%= @current_account.users.count %> members</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 bg-white shadow-sm rounded-lg">
          <div class="px-6 py-5">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
            <div class="space-y-3">
              <%= link_to team_account_path, class: "w-full inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
                <svg class="-ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                </svg>
                Manage Team
              <% end %>
              <%= link_to settings_account_path, class: "w-full inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
                <svg class="-ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Account Settings
              <% end %>
              <%= link_to billing_account_path, class: "w-full inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
                <svg class="-ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
                Billing & Subscription
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>