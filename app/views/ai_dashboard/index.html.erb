<% content_for :title, "AI Dashboard" %>

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-purple-50 to-blue-50">
  <!-- Header -->
  <div class="bg-white/80 backdrop-blur-sm border-b border-slate-200/60 sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <div class="w-12 h-12 bg-gradient-to-br from-purple-500 via-blue-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-slate-900">AI Dashboard</h1>
            <p class="text-slate-600">Multi-LLM content generation and insights</p>
          </div>
        </div>
        
        <!-- Real-time Status -->
        <div class="flex items-center space-x-4">
          <div id="ai-providers-status" class="flex items-center space-x-2">
            <!-- Will be populated by JavaScript -->
          </div>
          <button id="refresh-dashboard" class="p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- AI Insights Panel -->
    <div class="mb-8">
      <div class="bg-white rounded-2xl shadow-xl border border-slate-200/60 overflow-hidden">
        <div class="bg-gradient-to-r from-purple-600 to-blue-600 px-6 py-4">
          <h2 class="text-xl font-semibold text-white flex items-center">
            <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            AI-Powered Insights
          </h2>
        </div>
        <div id="ai-insights" class="p-6">
          <!-- Insights will be loaded here -->
          <div class="flex items-center justify-center py-8">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
            <span class="ml-3 text-slate-600">Loading AI insights...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Content Generation Hub -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200/60 overflow-hidden">
          <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
            <h2 class="text-xl font-semibold text-white flex items-center">
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Content Generation Hub
            </h2>
          </div>
          <div class="p-6">
            <!-- Content Type Selector -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-slate-700 mb-3">Content Type</label>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <button class="content-type-btn active" data-type="email_subject">
                  <div class="p-4 border-2 border-blue-200 bg-blue-50 rounded-lg text-center hover:border-blue-300 transition-colors">
                    <svg class="w-6 h-6 mx-auto mb-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span class="text-sm font-medium text-blue-900">Email Subject</span>
                  </div>
                </button>
                <button class="content-type-btn" data-type="email_body">
                  <div class="p-4 border-2 border-slate-200 rounded-lg text-center hover:border-slate-300 transition-colors">
                    <svg class="w-6 h-6 mx-auto mb-2 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="text-sm font-medium text-slate-700">Email Body</span>
                  </div>
                </button>
                <button class="content-type-btn" data-type="social_post">
                  <div class="p-4 border-2 border-slate-200 rounded-lg text-center hover:border-slate-300 transition-colors">
                    <svg class="w-6 h-6 mx-auto mb-2 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                    </svg>
                    <span class="text-sm font-medium text-slate-700">Social Post</span>
                  </div>
                </button>
                <button class="content-type-btn" data-type="ad_copy">
                  <div class="p-4 border-2 border-slate-200 rounded-lg text-center hover:border-slate-300 transition-colors">
                    <svg class="w-6 h-6 mx-auto mb-2 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                    </svg>
                    <span class="text-sm font-medium text-slate-700">Ad Copy</span>
                  </div>
                </button>
              </div>
            </div>

            <!-- Generation Form -->
            <form id="content-generation-form" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Prompt</label>
                <textarea id="generation-prompt" rows="3" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Describe what you want to generate..."></textarea>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-2">AI Provider</label>
                  <select id="ai-provider-select" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="auto">Auto-select Best Provider</option>
                    <!-- Will be populated by JavaScript -->
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-2">Tone</label>
                  <select id="tone-select" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="professional">Professional</option>
                    <option value="casual">Casual</option>
                    <option value="friendly">Friendly</option>
                    <option value="urgent">Urgent</option>
                    <option value="persuasive">Persuasive</option>
                  </select>
                </div>
              </div>
              
              <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 px-6 rounded-lg font-medium hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200 shadow-lg hover:shadow-xl">
                <span class="flex items-center justify-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                  Generate Content
                </span>
              </button>
            </form>

            <!-- Progress Tracking -->
            <div id="generation-progress" class="mt-6 hidden">
              <div class="border-t border-slate-200 pt-6">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg font-medium text-slate-900">Generation Progress</h3>
                  <span class="status-text text-sm text-slate-600">Initializing...</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2 mb-4">
                  <div class="progress-bar bg-gradient-to-r from-blue-500 to-indigo-600 h-2 rounded-full transition-all duration-300" style="width: 0%" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="error-message hidden text-red-600 text-sm mb-4"></div>
              </div>
            </div>

            <!-- Generated Content Display -->
            <div id="generated-content" class="mt-6 hidden">
              <div class="border-t border-slate-200 pt-6">
                <h3 class="text-lg font-medium text-slate-900 mb-4">Generated Content</h3>
                <div id="content-output" class="bg-slate-50 rounded-lg p-4 mb-4">
                  <div class="generated-content hidden"></div>
                </div>
                <div class="generation-actions mt-4 flex space-x-3 hidden">
                  <button id="approve-content" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                    Approve
                  </button>
                  <button id="reject-content" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                    Reject
                  </button>
                  <button id="regenerate-content" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    Regenerate
                  </button>
                </div>
              </div>
            </div>

            <!-- Bulk Operations -->
            <div class="mt-6 border-t border-slate-200 pt-6">
              <h3 class="text-lg font-medium text-slate-900 mb-4">Bulk Operations</h3>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-2">Bulk Generation</label>
                  <textarea id="bulk-prompts" rows="4" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Enter multiple prompts, one per line..."></textarea>
                </div>
                <button id="bulk-generate-btn" class="w-full bg-gradient-to-r from-purple-600 to-pink-600 text-white py-3 px-6 rounded-lg font-medium hover:from-purple-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200 shadow-lg hover:shadow-xl">
                  <span class="flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                    Generate Multiple Content
                  </span>
                </button>
              </div>
              
              <!-- Bulk Progress -->
              <div id="bulk-progress" class="mt-4 hidden">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-medium text-slate-700">Bulk Operation Progress</span>
                  <span class="bulk-status text-sm text-slate-600">0/0 completed</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                  <div class="bulk-progress-bar bg-gradient-to-r from-purple-500 to-pink-600 h-2 rounded-full transition-all duration-300" style="width: 0%" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- AI Provider Status -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200/60 overflow-hidden">
          <div class="bg-gradient-to-r from-green-600 to-emerald-600 px-4 py-3">
            <h3 class="text-lg font-semibold text-white">AI Providers</h3>
          </div>
          <div id="providers-list" class="p-4">
            <!-- Provider status will be loaded here -->
          </div>
        </div>

        <!-- Performance Metrics -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200/60 overflow-hidden">
          <div class="bg-gradient-to-r from-orange-600 to-red-600 px-4 py-3">
            <h3 class="text-lg font-semibold text-white">Performance</h3>
          </div>
          <div id="performance-metrics" class="p-4">
            <!-- Metrics will be loaded here -->
          </div>
        </div>

        <!-- Recent Generations -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200/60 overflow-hidden">
          <div class="bg-gradient-to-r from-purple-600 to-pink-600 px-4 py-3">
            <h3 class="text-lg font-semibold text-white">Recent Generations</h3>
          </div>
          <div id="recent-generations" class="p-4">
            <!-- Recent generations will be loaded here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for AI Dashboard -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize dashboard
    initializeAIDashboard();
    
    // Set up real-time updates
    setInterval(updateDashboardMetrics, 30000); // Update every 30 seconds
    
    // Content type selection
    document.querySelectorAll('.content-type-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.content-type-btn').forEach(b => {
          b.querySelector('div').className = 'p-4 border-2 border-slate-200 rounded-lg text-center hover:border-slate-300 transition-colors';
          b.querySelector('span').className = 'text-sm font-medium text-slate-700';
          b.querySelector('svg').className = 'w-6 h-6 mx-auto mb-2 text-slate-600';
        });
        
        this.querySelector('div').className = 'p-4 border-2 border-blue-200 bg-blue-50 rounded-lg text-center hover:border-blue-300 transition-colors';
        this.querySelector('span').className = 'text-sm font-medium text-blue-900';
        this.querySelector('svg').className = 'w-6 h-6 mx-auto mb-2 text-blue-600';
      });
    });
    
    // Content generation form
    document.getElementById('content-generation-form').addEventListener('submit', function(e) {
      e.preventDefault();
      generateContent();
    });
    
    // Bulk generation
    document.getElementById('bulk-generate-btn').addEventListener('click', function(e) {
      e.preventDefault();
      generateBulkContent();
    });
    
    // Content approval/rejection
    document.getElementById('approve-content').addEventListener('click', function() {
      handleContentAction('approve');
    });
    
    document.getElementById('reject-content').addEventListener('click', function() {
      handleContentAction('reject');
    });
    
    document.getElementById('regenerate-content').addEventListener('click', function() {
      generateContent();
    });
    
    // Refresh dashboard
    document.getElementById('refresh-dashboard').addEventListener('click', function() {
      refreshDashboard();
    });
  });
  
  function initializeAIDashboard() {
    loadAIInsights();
    loadProviders();
    loadPerformanceMetrics();
    loadRecentGenerations();
  }
  
  function loadAIInsights() {
    fetch('/ai_dashboard/insights')
      .then(response => response.json())
      .then(data => {
        const container = document.getElementById('ai-insights');
        if (data.insights && data.insights.length > 0) {
          container.innerHTML = data.insights.map(insight => `
            <div class="mb-4 p-4 bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg border border-blue-200">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h4 class="font-semibold text-slate-900">${insight.title}</h4>
                  <p class="text-slate-700 mt-1">${insight.content}</p>
                  <div class="mt-2 flex items-center space-x-4">
                    <span class="text-xs text-blue-600 bg-blue-100 px-2 py-1 rounded-full">Confidence: ${insight.confidence_score}%</span>
                    <span class="text-xs text-purple-600 bg-purple-100 px-2 py-1 rounded-full">${insight.insight_type}</span>
                  </div>
                </div>
                <div class="ml-4">
                  <button class="text-blue-600 hover:text-blue-800 text-sm font-medium">Implement</button>
                </div>
              </div>
            </div>
          `).join('');
        } else {
          container.innerHTML = '<p class="text-slate-600 text-center py-8">No insights available yet. Generate some content to get AI-powered recommendations!</p>';
        }
      })
      .catch(error => {
        console.error('Error loading insights:', error);
        document.getElementById('ai-insights').innerHTML = '<p class="text-red-600 text-center py-8">Error loading insights. Please try again.</p>';
      });
  }
  
  function loadProviders() {
    fetch('/ai_dashboard/providers')
      .then(response => response.json())
      .then(data => {
        const container = document.getElementById('providers-list');
        const select = document.getElementById('ai-provider-select');
        
        if (data.providers && data.providers.length > 0) {
          container.innerHTML = data.providers.map(provider => `
            <div class="flex items-center justify-between py-2 border-b border-slate-100 last:border-b-0">
              <div class="flex items-center space-x-3">
                <div class="w-3 h-3 rounded-full ${provider.health_status === 'healthy' ? 'bg-green-500' : 'bg-red-500'}"></div>
                <span class="font-medium text-slate-900">${provider.name}</span>
              </div>
              <span class="text-xs text-slate-500">${provider.provider_type}</span>
            </div>
          `).join('');
          
          // Populate provider select
          const options = data.providers.filter(p => p.health_status === 'healthy').map(provider => 
            `<option value="${provider.id}">${provider.name}</option>`
          ).join('');
          select.innerHTML = '<option value="auto">Auto-select Best Provider</option>' + options;
        } else {
          container.innerHTML = '<p class="text-slate-600 text-sm">No providers configured</p>';
        }
      });
  }
  
  function loadPerformanceMetrics() {
    fetch('/ai_dashboard/analytics')
      .then(response => response.json())
      .then(data => {
        const container = document.getElementById('performance-metrics');
        container.innerHTML = `
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-sm text-slate-600">Total Generations</span>
              <span class="font-semibold text-slate-900">${data.total_generations || 0}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm text-slate-600">Success Rate</span>
              <span class="font-semibold text-green-600">${data.success_rate || 0}%</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm text-slate-600">Avg Response Time</span>
              <span class="font-semibold text-slate-900">${data.avg_response_time || 0}ms</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm text-slate-600">Total Cost</span>
              <span class="font-semibold text-slate-900">$${data.total_cost || 0}</span>
            </div>
          </div>
        `;
      });
  }
  
  function loadRecentGenerations() {
    fetch('/ai_dashboard/content_generations')
      .then(response => response.json())
      .then(data => {
        const container = document.getElementById('recent-generations');
        if (data.generations && data.generations.length > 0) {
          container.innerHTML = data.generations.slice(0, 5).map(gen => `
            <div class="py-2 border-b border-slate-100 last:border-b-0">
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-slate-900">${gen.content_type}</span>
                <span class="text-xs px-2 py-1 rounded-full ${
                  gen.status === 'approved' ? 'bg-green-100 text-green-800' :
                  gen.status === 'rejected' ? 'bg-red-100 text-red-800' :
                  'bg-yellow-100 text-yellow-800'
                }">${gen.status}</span>
              </div>
              <p class="text-xs text-slate-600 mt-1 truncate">${gen.generated_content}</p>
            </div>
          `).join('');
        } else {
          container.innerHTML = '<p class="text-slate-600 text-sm">No generations yet</p>';
        }
      });
  }
  
  let currentGenerationId = null;
  
  function generateContent() {
    const form = document.getElementById('content-generation-form');
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    
    // Show loading state
    submitBtn.innerHTML = `
      <span class="flex items-center justify-center">
        <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
        Generating...
      </span>
    `;
    submitBtn.disabled = true;
    
    // Show progress section
    document.getElementById('generation-progress').classList.remove('hidden');
    document.getElementById('generated-content').classList.add('hidden');
    
    const formData = {
      content_type: document.querySelector('.content-type-btn.active')?.dataset.type || 'email_subject',
      prompt: document.getElementById('generation-prompt').value,
      ai_provider_id: document.getElementById('ai-provider-select').value,
      tone: document.getElementById('tone-select').value
    };
    
    fetch('/ai_dashboard/generate_content', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        currentGenerationId = data.generation_id;
        
        // Set up progress tracking
        const progressContainer = document.getElementById('generation-progress');
        progressContainer.setAttribute('data-generation-id', data.generation_id);
        
        // Start tracking this generation
        if (window.aiProgressTracker) {
          window.aiProgressTracker.trackGeneration(data.generation_id);
        }
        
        // Reset form
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      } else {
        showError('Failed to start content generation: ' + (data.message || 'Unknown error'));
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    })
    .catch(error => {
      console.error('Error:', error);
      showError('Network error occurred');
      submitBtn.innerHTML = originalText;
      submitBtn.disabled = false;
    });
  }
  
  function generateBulkContent() {
    const bulkBtn = document.getElementById('bulk-generate-btn');
    const originalText = bulkBtn.innerHTML;
    const prompts = document.getElementById('bulk-prompts').value.trim();
    
    if (!prompts) {
      alert('Please enter at least one prompt');
      return;
    }
    
    const promptList = prompts.split('\n').filter(p => p.trim());
    
    if (promptList.length === 0) {
      alert('Please enter valid prompts');
      return;
    }
    
    // Show loading state
    bulkBtn.innerHTML = `
      <span class="flex items-center justify-center">
        <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
        Starting Bulk Generation...
      </span>
    `;
    bulkBtn.disabled = true;
    
    // Show bulk progress
    document.getElementById('bulk-progress').classList.remove('hidden');
    
    const formData = {
      prompts: promptList,
      content_type: document.querySelector('.content-type-btn.active')?.dataset.type || 'email_subject',
      ai_provider_id: document.getElementById('ai-provider-select').value,
      tone: document.getElementById('tone-select').value
    };
    
    fetch('/ai_dashboard/bulk_generate', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Set up bulk progress tracking
        const bulkProgress = document.getElementById('bulk-progress');
        bulkProgress.setAttribute('data-job-id', data.job_id);
        
        // Start tracking bulk operation
        if (window.aiProgressTracker) {
          window.aiProgressTracker.trackBulkOperation(data.job_id);
        }
        
        // Reset form
        bulkBtn.innerHTML = originalText;
        bulkBtn.disabled = false;
        document.getElementById('bulk-prompts').value = '';
      } else {
        showError('Failed to start bulk generation: ' + (data.message || 'Unknown error'));
        bulkBtn.innerHTML = originalText;
        bulkBtn.disabled = false;
      }
    })
    .catch(error => {
      console.error('Error:', error);
      showError('Network error occurred');
      bulkBtn.innerHTML = originalText;
      bulkBtn.disabled = false;
    });
  }
  
  function handleContentAction(action) {
    if (!currentGenerationId) {
      alert('No content to ' + action);
      return;
    }
    
    fetch(`/ai_dashboard/content_generations/${currentGenerationId}/${action}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Update UI to reflect the action
        const statusElement = document.querySelector('.status-text');
        if (statusElement) {
          statusElement.textContent = action === 'approve' ? 'Approved' : 'Rejected';
          statusElement.className = `status-text ${action === 'approve' ? 'text-green-600' : 'text-red-600'}`;
        }
        
        // Refresh recent generations
        loadRecentGenerations();
      } else {
        alert('Failed to ' + action + ' content: ' + (data.message || 'Unknown error'));
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Network error occurred');
    });
  }
  
  function showError(message) {
    const errorElement = document.querySelector('.error-message');
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
  }
  
  function showGeneratedContent(content, providerName, qualityScore) {
    document.getElementById('generation-progress').classList.add('hidden');
    document.getElementById('generated-content').classList.remove('hidden');
    
    document.querySelector('.generated-content').innerHTML = `
      <div class="space-y-3">
        <div class="bg-white p-4 rounded-lg border border-slate-200">
          <p class="text-slate-900">${content}</p>
        </div>
        <div class="flex items-center justify-between text-sm text-slate-600">
          <span>Generated by: ${providerName}</span>
          <span>Quality Score: ${qualityScore}/100</span>
        </div>
      </div>
        `;
        document.getElementById('generated-content').classList.remove('hidden');
        
        // Store generation ID for approval/rejection
        document.getElementById('generated-content').dataset.generationId = data.generation_id;
      } else {
        alert('Error generating content: ' + data.error);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error generating content. Please try again.');
    })
    .finally(() => {
      submitBtn.innerHTML = originalText;
      submitBtn.disabled = false;
    });
  }
  
  function updateDashboardMetrics() {
    fetch('/ai_dashboard/real_time_metrics')
      .then(response => response.json())
      .then(data => {
        // Update AI status
        const statusEl = document.getElementById('ai-status');
        if (statusEl) {
          statusEl.innerHTML = `
            <div class="w-2 h-2 ${data.ai_online ? 'bg-green-500' : 'bg-red-500'} rounded-full animate-pulse"></div>
            <span class="text-sm text-gray-500">${data.ai_online ? 'AI Online' : 'AI Offline'}</span>
            <span class="text-xs text-green-600 bg-green-100 px-2 py-1 rounded-full ml-2">${data.active_providers} Providers</span>
          `;
        }
        
        // Update provider status
        loadProviders();
        loadPerformanceMetrics();
      })
      .catch(error => console.error('Error updating metrics:', error));
  }
  
  function refreshDashboard() {
    const refreshBtn = document.getElementById('refresh-dashboard');
    refreshBtn.classList.add('animate-spin');
    
    initializeAIDashboard();
    
    setTimeout(() => {
      refreshBtn.classList.remove('animate-spin');
    }, 1000);
  }
</script>