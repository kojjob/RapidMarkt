<% content_for :title, "Dashboard - RapidMarkt" %>

<!-- Modern Dashboard Container -->
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50">
  <!-- Enhanced Header Section -->
  <div class="bg-white/80 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-10">
    <div class="px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <!-- Header Content -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center">
            <div>
              <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
                Good <%= Time.current.hour < 12 ? 'morning' : Time.current.hour < 18 ? 'afternoon' : 'evening' %>!
              </h1>
              <p class="mt-1 text-lg text-gray-600">
                Here's what's happening with your marketing campaigns today.
              </p>
            </div>
            <div class="ml-4 hidden sm:block">
              <div class="flex items-center space-x-2">
                <div class="h-2 w-2 bg-green-400 rounded-full animate-pulse"></div>
                <span class="text-sm text-gray-500">Live updates</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="mt-4 sm:mt-0 flex flex-col sm:flex-row sm:items-center space-y-3 sm:space-y-0 sm:space-x-3">
          <%= link_to new_campaign_path, 
              class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Campaign
          <% end %>
          
          <%= link_to new_template_path, 
              class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            New Template
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Dashboard Content -->
  <div class="px-4 sm:px-6 lg:px-8 py-8">
    <!-- Enhanced Metrics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Campaigns Card -->
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Total Campaigns</p>
              <p class="text-3xl font-bold text-gray-900 mt-2"><%= @campaigns_count %></p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-green-600 font-medium">+12%</span>
                <span class="text-sm text-gray-500 ml-1">from last month</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 7.89a2 2 0 002.83 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-3">
          <%= link_to campaigns_path, class: "text-sm font-medium text-blue-700 hover:text-blue-900 flex items-center group" do %>
            View all campaigns
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      </div>

      <!-- Total Contacts Card -->
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Total Contacts</p>
              <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@contacts_count) %></p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-green-600 font-medium">+8%</span>
                <span class="text-sm text-gray-500 ml-1">from last month</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 px-6 py-3">
          <%= link_to contacts_path, class: "text-sm font-medium text-green-700 hover:text-green-900 flex items-center group" do %>
            View all contacts
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      </div>

      <!-- Emails Sent Card -->
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Emails Sent</p>
              <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@campaign_stats[:total_sent]) %></p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-purple-600 font-medium">+24%</span>
                <span class="text-sm text-gray-500 ml-1">from last month</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-purple-50 to-pink-50 px-6 py-3">
          <%= link_to analytics_path, class: "text-sm font-medium text-purple-700 hover:text-purple-900 flex items-center group" do %>
            View analytics
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      </div>

      <!-- Open Rate Card -->
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Open Rate</p>
              <p class="text-3xl font-bold text-gray-900 mt-2">
                <% if @campaign_stats[:total_sent] > 0 %>
                  <%= number_to_percentage((@campaign_stats[:total_opened].to_f / @campaign_stats[:total_sent] * 100), precision: 1) %>
                <% else %>
                  0%
                <% end %>
              </p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-orange-600 font-medium">+3.2%</span>
                <span class="text-sm text-gray-500 ml-1">from last month</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-orange-50 to-red-50 px-6 py-3">
          <%= link_to analytics_path, class: "text-sm font-medium text-orange-700 hover:text-orange-900 flex items-center group" do %>
            View details
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Recent Campaigns Section -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-xl font-bold text-gray-900">Recent Campaigns</h2>
                <p class="text-sm text-gray-600 mt-1">Your latest email marketing campaigns and their performance</p>
              </div>
              <%= link_to campaigns_path, 
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-xl text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-200" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                View all
              <% end %>
            </div>
          </div>

          <div class="overflow-hidden">
            <% if @recent_campaigns.any? %>
              <div class="divide-y divide-gray-100">
                <% @recent_campaigns.each_with_index do |campaign, index| %>
                  <div class="p-6 hover:bg-gray-50 transition-colors duration-200 group">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center space-x-4 flex-1">
                        <!-- Status Badge -->
                        <div class="flex-shrink-0">
                          <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold
                            <%= case campaign.status
                                when 'draft' then 'bg-gray-100 text-gray-800 border border-gray-200'
                                when 'sending' then 'bg-yellow-100 text-yellow-800 border border-yellow-200'
                                when 'sent' then 'bg-green-100 text-green-800 border border-green-200'
                                when 'scheduled' then 'bg-blue-100 text-blue-800 border border-blue-200'
                                else 'bg-gray-100 text-gray-800 border border-gray-200'
                                end %>">
                            <div class="w-1.5 h-1.5 rounded-full mr-2
                              <%= case campaign.status
                                  when 'draft' then 'bg-gray-400'
                                  when 'sending' then 'bg-yellow-400 animate-pulse'
                                  when 'sent' then 'bg-green-400'
                                  when 'scheduled' then 'bg-blue-400'
                                  else 'bg-gray-400'
                                  end %>"></div>
                            <%= campaign.status.humanize %>
                          </span>
                        </div>

                        <!-- Campaign Info -->
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center space-x-2">
                            <%= link_to campaign_path(campaign), 
                                class: "text-lg font-semibold text-gray-900 hover:text-indigo-600 transition-colors duration-200 group-hover:text-indigo-600" do %>
                              <%= campaign.name %>
                            <% end %>
                            <% if campaign.scheduled_at && campaign.scheduled? %>
                              <div class="flex items-center text-xs text-blue-600 bg-blue-50 px-2 py-1 rounded-md">
                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Scheduled for <%= campaign.scheduled_at.strftime("%b %d, %Y at %I:%M %p") %>
                              </div>
                            <% end %>
                          </div>
                          <p class="text-sm text-gray-600 mt-1">
                            <%= truncate(campaign.subject, length: 60) %>
                          </p>
                          <div class="flex items-center text-xs text-gray-500 mt-2 space-x-4">
                            <span>Created <%= time_ago_in_words(campaign.created_at) %> ago</span>
                            <% if campaign.template %>
                              <span>• Template: <%= campaign.template.name %></span>
                            <% end %>
                          </div>
                        </div>
                      </div>

                      <!-- Campaign Stats -->
                      <div class="flex items-center space-x-6 text-right">
                        <% if campaign.sent? %>
                          <div class="text-center">
                            <p class="text-lg font-bold text-gray-900">
                              <%= number_with_delimiter(campaign.campaign_contacts.where.not(sent_at: nil).count) %>
                            </p>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Sent</p>
                          </div>
                          <div class="text-center">
                            <p class="text-lg font-bold text-green-600">
                              <%= number_with_delimiter(campaign.campaign_contacts.where.not(opened_at: nil).count) %>
                            </p>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Opened</p>
                          </div>
                          <div class="text-center">
                            <p class="text-lg font-bold text-blue-600">
                              <% sent_count = campaign.campaign_contacts.where.not(sent_at: nil).count %>
                              <% opened_count = campaign.campaign_contacts.where.not(opened_at: nil).count %>
                              <% if sent_count > 0 %>
                                <%= number_to_percentage((opened_count.to_f / sent_count * 100), precision: 1) %>
                              <% else %>
                                0%
                              <% end %>
                            </p>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Rate</p>
                          </div>
                        <% elsif campaign.scheduled? %>
                          <div class="text-center">
                            <div class="inline-flex items-center text-blue-600">
                              <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                              </svg>
                              <span class="text-sm font-medium">Scheduled</span>
                            </div>
                          </div>
                        <% else %>
                          <div class="text-center">
                            <div class="inline-flex items-center text-gray-400">
                              <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                              </svg>
                              <span class="text-sm font-medium">Draft</span>
                            </div>
                          </div>
                        <% end %>

                        <!-- Arrow -->
                        <div class="flex-shrink-0">
                          <svg class="w-5 h-5 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                          </svg>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <!-- Enhanced Empty State -->
              <div class="text-center py-16">
                <div class="mx-auto h-24 w-24 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6">
                  <svg class="h-12 w-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 7.89a2 2 0 002.83 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Ready to launch your first campaign?</h3>
                <p class="text-gray-600 mb-8 max-w-md mx-auto">
                  Create engaging email campaigns that connect with your audience and drive results.
                </p>
                <div class="flex flex-col sm:flex-row justify-center space-y-3 sm:space-y-0 sm:space-x-4">
                  <%= link_to new_campaign_path, 
                      class: "inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Create Campaign
                  <% end %>
                  <%= link_to templates_path, 
                      class: "inline-flex items-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Browse Templates
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Sidebar with Quick Actions and Activity -->
      <div class="space-y-8">
        <!-- Quick Launch Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-200">
            <h3 class="text-lg font-bold text-gray-900">Quick Launch</h3>
            <p class="text-sm text-gray-600 mt-1">Start creating with these common actions</p>
          </div>
          <div class="p-6">
            <div class="space-y-4">
              <%= link_to new_campaign_path, 
                  class: "flex items-center p-4 rounded-xl border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50 transition-all duration-200 group" do %>
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 7.89a2 2 0 002.83 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                </div>
                <div class="ml-4 flex-1">
                  <p class="text-sm font-medium text-gray-900 group-hover:text-indigo-900">Create Campaign</p>
                  <p class="text-xs text-gray-500">Start a new email campaign</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-indigo-600 group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>

              <%= link_to new_template_path, 
                  class: "flex items-center p-4 rounded-xl border border-gray-200 hover:border-purple-300 hover:bg-purple-50 transition-all duration-200 group" do %>
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                </div>
                <div class="ml-4 flex-1">
                  <p class="text-sm font-medium text-gray-900 group-hover:text-purple-900">Design Template</p>
                  <p class="text-xs text-gray-500">Create a reusable template</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>

              <%= link_to new_contact_path, 
                  class: "flex items-center p-4 rounded-xl border border-gray-200 hover:border-green-300 hover:bg-green-50 transition-all duration-200 group" do %>
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                </div>
                <div class="ml-4 flex-1">
                  <p class="text-sm font-medium text-gray-900 group-hover:text-green-900">Add Contact</p>
                  <p class="text-xs text-gray-500">Grow your audience</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-green-600 group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>

              <%= link_to analytics_path, 
                  class: "flex items-center p-4 rounded-xl border border-gray-200 hover:border-orange-300 hover:bg-orange-50 transition-all duration-200 group" do %>
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-red-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                  </div>
                </div>
                <div class="ml-4 flex-1">
                  <p class="text-sm font-medium text-gray-900 group-hover:text-orange-900">View Analytics</p>
                  <p class="text-xs text-gray-500">Track performance</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-orange-600 group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Recent Activity -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-200">
            <h3 class="text-lg font-bold text-gray-900">Recent Activity</h3>
            <p class="text-sm text-gray-600 mt-1">Latest updates from your account</p>
          </div>
          <div class="p-6">
            <div class="space-y-4">
              <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                  <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-gray-900">Campaign "Newsletter Dec 2024" was sent successfully</p>
                  <p class="text-xs text-gray-500">2 hours ago</p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                  <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-gray-900">5 new contacts added to your list</p>
                  <p class="text-xs text-gray-500">1 day ago</p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                  <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-gray-900">Template "Welcome Email" was updated</p>
                  <p class="text-xs text-gray-500">2 days ago</p>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                  <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-gray-900">Monthly analytics report is ready</p>
                  <p class="text-xs text-gray-500">3 days ago</p>
                </div>
              </div>
            </div>
            
            <div class="mt-6 pt-4 border-t border-gray-100">
              <%= link_to "#", class: "text-sm font-medium text-indigo-600 hover:text-indigo-500 flex items-center group" do %>
                View all activity
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Tips & Insights -->
        <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl shadow-sm overflow-hidden text-white">
          <div class="px-6 py-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <h3 class="ml-3 text-lg font-bold">Pro Tip</h3>
            </div>
            <p class="mt-3 text-indigo-100">
              Your open rates are 15% above industry average! Try A/B testing your subject lines to increase engagement even more.
            </p>
            <div class="mt-4">
              <%= link_to "#", class: "inline-flex items-center text-sm font-medium text-white hover:text-indigo-200 transition-colors" do %>
                Learn more about A/B testing
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>