<% content_for :title, "Templates - RapidMarkt" %>

<!-- Modern Templates Container -->
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-purple-50 to-pink-50" data-controller="dropdown">
  <!-- Header Section -->
  <div class="bg-white/90 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-20">
    <div class="px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <div class="flex-1 min-w-0">
          <div class="flex items-center">
            <div>
              <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
                Email Templates
              </h1>
              <p class="mt-1 text-lg text-gray-600">
                Create and manage reusable email templates for your campaigns.
              </p>
            </div>
            <div class="ml-4 hidden sm:block">
              <div class="flex items-center space-x-2">
                <div class="h-2 w-2 bg-purple-400 rounded-full animate-pulse"></div>
                <span class="text-sm text-gray-500">Auto-save enabled</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="mt-4 sm:mt-0 flex flex-col sm:flex-row sm:items-center space-y-3 sm:space-y-0 sm:space-x-3">
          <%= link_to builder_templates_path, 
              class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
            </svg>
            Visual Builder
          <% end %>
          
          <%= link_to new_template_path, 
              class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-gradient-to-r from-purple-500 to-pink-600 hover:from-purple-600 hover:to-pink-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Create Template
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="px-4 sm:px-6 lg:px-8 py-8">
    <!-- Search Section -->
    <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex items-center mb-4">
        <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900">Search Templates</h3>
      </div>
      
      <%= form_with url: templates_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-4" do |form| %>
        <div class="flex-1">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <%= form.text_field :search, value: params[:search], 
                placeholder: "Search by template name or subject...",
                class: "pl-10 block w-full border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-sm" %>
          </div>
        </div>
        <div class="flex items-center space-x-3">
          <%= form.submit "Search", 
              class: "px-6 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-purple-600 hover:bg-purple-700 focus:ring-2 focus:ring-purple-500 shadow-md hover:shadow-lg transition-all" %>
          <% if params[:search].present? %>
            <%= link_to templates_path, 
                class: "px-6 py-3 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:ring-2 focus:ring-purple-500 shadow-md hover:shadow-lg transition-all" do %>
              Clear
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Templates Grid -->
    <% if @templates.any? %>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <% @templates.each do |template| %>
          <div class="group bg-white/90 backdrop-blur-sm overflow-hidden shadow-sm border border-gray-200 rounded-2xl hover:shadow-xl hover:scale-105 transition-all duration-300">
            <!-- Template Preview -->
            <div class="bg-gradient-to-br from-purple-100 to-pink-100 h-32 relative overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center">
                <svg class="w-16 h-16 text-purple-400 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div class="absolute top-3 right-3">
                <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs font-medium bg-white/80 text-purple-700">
                  <% campaigns_count = template.campaigns.count %>
                  <%= campaigns_count %> uses
                </span>
              </div>
            </div>
            
            <!-- Template Content -->
            <div class="p-6">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-semibold text-gray-900 truncate group-hover:text-purple-600 transition-colors">
                    <%= link_to template.name, template_path(template) %>
                  </h3>
                  <p class="mt-1 text-sm text-gray-600 truncate">
                    <%= template.subject %>
                  </p>
                </div>
                <div class="relative ml-4" data-controller="dropdown">
                  <button type="button"
                          class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors"
                          data-action="click->dropdown#toggle"
                          aria-label="Template options">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/>
                    </svg>
                  </button>
                  <div class="origin-top-right absolute right-0 mt-2 w-56 rounded-xl shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50" 
                       data-dropdown-target="menu">
                    <div class="py-2">
                      <%= link_to template_path(template), 
                          class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors" do %>
                        <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        View Details
                      <% end %>
                      <%= link_to builder_templates_path(template_id: template.id), 
                          class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors" do %>
                        <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
                        </svg>
                        Visual Builder
                      <% end %>
                      <%= link_to edit_template_path(template), 
                          class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors" do %>
                        <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        Simple Editor
                      <% end %>
                      <%= link_to preview_template_path(template), 
                          class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors",
                          target: "_blank" do %>
                        <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                        </svg>
                        Preview
                      <% end %>
                      <%= link_to duplicate_template_path(template), 
                          data: { turbo_method: :post },
                          class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-colors" do %>
                        <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                        Duplicate
                      <% end %>
                      <div class="border-t border-gray-100 my-1"></div>
                      <%= link_to template_path(template), 
                          data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this template?' },
                          class: "flex items-center px-4 py-2 text-sm text-red-700 hover:bg-red-50 transition-colors" do %>
                        <svg class="w-4 h-4 mr-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Delete
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Template Preview Text -->
              <% if template.body.present? %>
                <div class="mb-4">
                  <p class="text-sm text-gray-600 leading-relaxed line-clamp-2">
                    <%= truncate(strip_tags(template.body), length: 100) %>
                  </p>
                </div>
              <% end %>
              
              <!-- Template Stats -->
              <div class="flex items-center justify-between text-xs text-gray-500 mb-4">
                <span>Created <%= time_ago_in_words(template.created_at) %> ago</span>
                <span class="text-purple-600 font-medium"><%= pluralize(campaigns_count, 'campaign') %></span>
              </div>
              
              <!-- Action Buttons -->
              <div class="flex space-x-2">
                <%= link_to template_path(template), 
                    class: "flex-1 inline-flex items-center justify-center px-3 py-2 border border-gray-300 text-xs font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:ring-2 focus:ring-purple-500 transition-all" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  View
                <% end %>
                <%= link_to edit_template_path(template), 
                    class: "flex-1 inline-flex items-center justify-center px-3 py-2 border border-transparent text-xs font-medium rounded-lg text-white bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 focus:ring-2 focus:ring-purple-500 transition-all" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Edit
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Pagination -->
      <div class="mt-8 flex justify-center">
        <%= paginate @templates if defined?(Kaminari) %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 text-center py-16">
        <div class="max-w-md mx-auto">
          <svg class="mx-auto h-20 w-20 text-purple-400 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">
            <% if params[:search].present? %>
              No templates found
            <% else %>
              No email templates yet
            <% end %>
          </h3>
          <p class="text-lg text-gray-600 mb-8">
            <% if params[:search].present? %>
              Try adjusting your search terms or create a new template to get started.
            <% else %>
              Create your first email template to streamline your campaigns.
            <% end %>
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <%= link_to new_template_path, 
                class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-gradient-to-r from-purple-500 to-pink-600 hover:from-purple-600 hover:to-pink-700 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Create Template
            <% end %>
            <%= link_to builder_templates_path, 
                class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-base font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
              </svg>
              Visual Builder
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>