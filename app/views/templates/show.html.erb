<% content_for :title, "#{@template.name} - Templates - RapidMarkt" %>

<!-- Modern Template Detail Container -->
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-purple-50 to-pink-50">
  <!-- Header Section -->
  <div class="bg-white/90 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-20">
    <div class="px-4 sm:px-6 lg:px-8 py-6">
      <!-- Breadcrumb -->
      <nav class="flex mb-4" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <%= link_to templates_path, class: "text-gray-500 hover:text-gray-700 transition-colors" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <%= link_to "Templates", templates_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors" %>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="flex-shrink-0 h-5 w-5 text-gray-300 mx-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm font-medium text-gray-900"><%= @template.name %></span>
            </div>
          </li>
        </ol>
      </nav>
      
      <!-- Header Content -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <div class="flex-1 min-w-0">
          <div class="flex items-center">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-100 to-pink-100 rounded-xl flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <div>
              <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
                <%= @template.name %>
              </h1>
              <p class="mt-1 text-lg text-gray-600">
                <%= @template.subject %>
              </p>
              <div class="mt-2 flex items-center space-x-4 text-sm text-gray-500">
                <span>Created <%= time_ago_in_words(@template.created_at) %> ago</span>
                <div class="h-1 w-1 bg-gray-300 rounded-full"></div>
                <span><%= pluralize(@template.campaigns.count, 'campaign') %> using this template</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="mt-6 sm:mt-0 flex flex-col sm:flex-row sm:items-center space-y-3 sm:space-y-0 sm:space-x-3">
          <%= link_to edit_template_path(@template), 
              class: "inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            Edit Template
          <% end %>
          
          <%= link_to preview_template_path(@template), 
              target: "_blank",
              class: "inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            Preview
          <% end %>
          
          <%= link_to duplicate_template_path(@template), 
              data: { turbo_method: :post },
              class: "inline-flex items-center justify-center px-4 py-2 border border-purple-300 text-sm font-medium rounded-xl text-purple-700 bg-purple-50 hover:bg-purple-100 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            Duplicate
          <% end %>
          
          <%= link_to template_path(@template), 
              data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this template? This action cannot be undone.' },
              class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-xl text-white bg-red-600 hover:bg-red-700 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Delete
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Template Content (Left Side - 2/3) -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Template Information Card -->
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-6">
            <div class="flex items-center mb-6">
              <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <h2 class="text-lg font-semibold text-gray-900">Template Information</h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-500 mb-1">Template Name</label>
                  <p class="text-sm text-gray-900 bg-gray-50 rounded-lg px-3 py-2"><%= @template.name %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-500 mb-1">Subject Line</label>
                  <p class="text-sm text-gray-900 bg-gray-50 rounded-lg px-3 py-2"><%= @template.subject %></p>
                </div>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-500 mb-1">Created</label>
                  <p class="text-sm text-gray-900 bg-gray-50 rounded-lg px-3 py-2"><%= @template.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-500 mb-1">Last Updated</label>
                  <p class="text-sm text-gray-900 bg-gray-50 rounded-lg px-3 py-2"><%= @template.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Email Content Preview Card -->
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-6">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center">
                <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Email Preview</h2>
              </div>
              <%= link_to preview_template_path(@template), 
                  target: "_blank",
                  class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-colors" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Full Preview
              <% end %>
            </div>
            
            <% if @template.body.present? %>
              <div class="space-y-4">
                <!-- Email Preview -->
                <div class="border border-gray-200 rounded-xl overflow-hidden bg-white">
                  <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
                    <div class="flex items-center space-x-2 text-xs text-gray-500">
                      <span class="font-medium">Subject:</span>
                      <span class="flex-1 truncate"><%= @template.subject %></span>
                    </div>
                  </div>
                  <div class="p-4">
                    <iframe srcdoc="<%= html_escape(@template.body) %>" 
                            class="w-full h-96 border-0 rounded-lg bg-white"
                            sandbox="allow-same-origin">
                    </iframe>
                  </div>
                </div>
                
                <!-- HTML Source Toggle -->
                <details class="group">
                  <summary class="flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700 hover:text-gray-900 bg-gray-50 rounded-lg px-4 py-3 transition-colors">
                    <svg class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    View HTML Source Code
                  </summary>
                  <div class="mt-3">
                    <div class="bg-gray-900 rounded-xl p-4 overflow-x-auto">
                      <pre class="text-xs text-gray-100"><code><%= @template.body %></code></pre>
                    </div>
                  </div>
                </details>
              </div>
            <% else %>
              <div class="text-center py-12">
                <div class="w-16 h-16 mx-auto bg-gradient-to-br from-purple-100 to-pink-100 rounded-2xl flex items-center justify-center mb-4">
                  <svg class="w-8 h-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No Content Available</h3>
                <p class="text-gray-500 mb-4">This template doesn't have any content yet.</p>
                <%= link_to edit_template_path(@template), 
                    class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-purple-600 hover:bg-purple-700" do %>
                  Add Content
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Sidebar (Right Side - 1/3) -->
      <div class="lg:col-span-1 space-y-6">
        <!-- Usage Statistics Card -->
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-6">
            <div class="flex items-center mb-6">
              <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              <h2 class="text-lg font-semibold text-gray-900">Usage Statistics</h2>
            </div>
            
            <div class="space-y-6">
              <div class="text-center">
                <div class="text-3xl font-bold text-purple-600 mb-1"><%= @template.campaigns.count %></div>
                <div class="text-sm text-gray-500">Campaigns using this template</div>
              </div>
              
              <div class="grid grid-cols-2 gap-4">
                <div class="text-center bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-4">
                  <div class="text-xl font-bold text-green-600 mb-1">
                    <%= @template.campaigns.joins(:campaign_contacts).where.not(campaign_contacts: { sent_at: nil }).count %>
                  </div>
                  <div class="text-xs text-green-700">Emails Sent</div>
                </div>
                
                <div class="text-center bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4">
                  <div class="text-xl font-bold text-blue-600 mb-1">
                    <%= @template.campaigns.joins(:campaign_contacts).where.not(campaign_contacts: { opened_at: nil }).count %>
                  </div>
                  <div class="text-xs text-blue-700">Emails Opened</div>
                </div>
              </div>
              
              <div class="text-center bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-4">
                <div class="text-2xl font-bold text-purple-600 mb-1">
                  <% total_sent = @template.campaigns.joins(:campaign_contacts).where.not(campaign_contacts: { sent_at: nil }).count %>
                  <% total_opened = @template.campaigns.joins(:campaign_contacts).where.not(campaign_contacts: { opened_at: nil }).count %>
                  <% if total_sent > 0 %>
                    <%= number_to_percentage((total_opened.to_f / total_sent) * 100, precision: 1) %>
                  <% else %>
                    <span class="text-gray-500">N/A</span>
                  <% end %>
                </div>
                <div class="text-sm text-purple-700">Average Open Rate</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Campaigns Card -->
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-6">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center">
                <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Recent Campaigns</h2>
              </div>
              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs font-medium bg-purple-100 text-purple-800">
                <%= @template.campaigns.count %> total
              </span>
            </div>
            
            <% recent_campaigns = @template.campaigns.order(created_at: :desc).limit(5) %>
            <% if recent_campaigns.any? %>
              <div class="space-y-3">
                <% recent_campaigns.each do |campaign| %>
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                    <div class="flex-1 min-w-0">
                      <%= link_to campaign_path(campaign), class: "text-sm font-medium text-gray-900 hover:text-purple-600 truncate block transition-colors" do %>
                        <%= campaign.name %>
                      <% end %>
                      <p class="text-xs text-gray-500 mt-1">
                        <%= time_ago_in_words(campaign.created_at) %> ago
                      </p>
                    </div>
                    <div class="ml-3 flex-shrink-0">
                      <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium 
                        <%= case campaign.status
                            when 'sent' then 'bg-green-100 text-green-800'
                            when 'scheduled' then 'bg-yellow-100 text-yellow-800'
                            when 'draft' then 'bg-gray-100 text-gray-800'
                            else 'bg-blue-100 text-blue-800'
                            end %>">
                        <%= campaign.status.humanize %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </div>
              
              <div class="mt-4 pt-4 border-t border-gray-200 text-center">
                <%= link_to campaigns_path(template_id: @template.id), 
                    class: "text-sm text-purple-600 hover:text-purple-800 font-medium transition-colors" do %>
                  View all campaigns using this template →
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-8">
                <div class="w-12 h-12 mx-auto bg-gradient-to-br from-purple-100 to-pink-100 rounded-xl flex items-center justify-center mb-4">
                  <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"/>
                  </svg>
                </div>
                <h3 class="text-sm font-medium text-gray-900 mb-2">No campaigns yet</h3>
                <p class="text-xs text-gray-500 mb-4">This template hasn't been used in any campaigns.</p>
                <%= link_to new_campaign_path(template_id: @template.id), 
                    class: "inline-flex items-center px-4 py-2 border border-transparent text-xs font-medium rounded-lg text-white bg-purple-600 hover:bg-purple-700 transition-colors" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  Create Campaign
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-6">
            <div class="flex items-center mb-4">
              <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
            </div>
            
            <div class="space-y-3">
              <%= link_to builder_templates_path(template_id: @template.id), 
                  class: "block w-full text-left px-4 py-3 text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors" do %>
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
                  </svg>
                  Open in Visual Builder
                </div>
              <% end %>
              
              <%= link_to new_campaign_path(template_id: @template.id), 
                  class: "block w-full text-left px-4 py-3 text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors" do %>
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"/>
                  </svg>
                  Create Campaign with Template
                </div>
              <% end %>
              
              <%= link_to templates_path, 
                  class: "block w-full text-left px-4 py-3 text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors" do %>
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                  View All Templates
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>