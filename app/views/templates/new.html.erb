<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50">
  <div class="container mx-auto px-6 py-8">
    <!-- Modern Header -->
    <div class="bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-200/50 mb-8 overflow-hidden">
      <div class="px-8 py-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <!-- Brand and Navigation -->
          <div class="flex items-center space-x-8">
            <%= link_to root_path, class: "flex items-center space-x-4 group" do %>
              <div class="w-12 h-12 bg-gradient-to-br from-blue-600 via-purple-600 to-pink-600 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-all duration-300 shadow-lg">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div>
                <h1 class="text-2xl font-bold bg-gradient-to-r from-slate-800 to-slate-600 bg-clip-text text-transparent">RapidMarkt</h1>
                <p class="text-sm text-slate-500 font-medium">Template Builder</p>
              </div>
            <% end %>

            <!-- Breadcrumb -->
            <nav class="hidden md:flex items-center space-x-3 text-sm">
              <%= link_to dashboard_path, class: "text-slate-500 hover:text-blue-600 transition-colors duration-200 p-1 rounded-lg hover:bg-blue-50" do %>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                </svg>
              <% end %>
              <svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              <%= link_to "Templates", templates_path, class: "text-slate-500 hover:text-blue-600 transition-colors duration-200 px-2 py-1 rounded-lg hover:bg-blue-50" %>
              <svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-blue-600 font-semibold px-2 py-1 bg-blue-50 rounded-lg">New Template</span>
            </nav>
          </div>

          <!-- Template Form -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <%= form_with model: @template, local: true, class: "flex flex-col sm:flex-row items-stretch sm:items-center gap-4", id: "template-form" do |form| %>
              <%= form.text_field :name,
                  placeholder: "Enter template name...",
                  required: true,
                  class: "px-5 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 transition-all duration-300 placeholder-slate-400 min-w-[220px] shadow-sm hover:shadow-md focus:shadow-lg" %>

              <%= form.select :template_type, 
                  options_for_select(::Template.template_types.map { |key, value| [key.humanize.titleize, key] }, @template.template_type), 
                  { prompt: 'Select Type' }, 
                  { class: "px-5 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 transition-all duration-300 min-w-[180px] shadow-sm hover:shadow-md focus:shadow-lg" } %>
            <% end %>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center gap-3">
            <% if @template.persisted? %>
              <%= link_to template_path(@template), class: "px-5 py-3 text-sm font-medium text-slate-600 bg-white/90 backdrop-blur-sm rounded-2xl hover:bg-slate-50 border border-slate-200 transition-all duration-200 flex items-center space-x-2 shadow-sm hover:shadow-md", target: "_blank" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                <span>Preview</span>
              <% end %>
            <% else %>
              <button type="button" class="px-5 py-3 text-sm font-medium text-slate-400 bg-slate-100 rounded-2xl cursor-not-allowed flex items-center space-x-2" disabled>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                <span>Preview</span>
              </button>
            <% end %>

            <button type="button" onclick="saveDraft()" class="px-5 py-3 text-sm font-medium text-slate-600 bg-white/90 backdrop-blur-sm rounded-2xl hover:bg-slate-50 border border-slate-200 transition-all duration-200 flex items-center space-x-2 shadow-sm hover:shadow-md">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
              <span>Save Draft</span>
            </button>

            <button type="button" onclick="publishTemplate()" class="px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 rounded-2xl hover:from-blue-700 hover:via-purple-700 hover:to-pink-700 transition-all duration-300 transform hover:scale-105 flex items-center space-x-2 shadow-lg hover:shadow-xl">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l7-7 3 3-7 7-3-3z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
              </svg>
              <span>Publish</span>
            </button>
          </div>
        </div>

        <!-- Enhanced Status Bar -->
        <div class="mt-8 pt-6 border-t border-slate-200/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-6">
            <div class="flex items-center space-x-3">
              <span class="text-slate-500 font-medium">Status:</span>
              <span class="px-3 py-1.5 bg-gradient-to-r from-emerald-100 to-green-100 text-emerald-700 rounded-xl font-semibold text-sm shadow-sm">
                <%= @template.persisted? ? @template.status&.humanize || 'Draft' : 'New Template' %>
              </span>
            </div>
            <div class="flex items-center space-x-3">
              <span class="text-slate-500 font-medium">Last Saved:</span>
              <span class="text-slate-700 font-semibold">
                <%= @template.updated_at&.strftime('%H:%M') || 'Never' %>
              </span>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-slate-500 font-medium">Auto-save:</span>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer">
              <div class="w-12 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300/50 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-blue-600 peer-checked:to-purple-600 shadow-sm"></div>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Builder Layout -->
    <div class="flex flex-col xl:flex-row gap-8 h-[calc(100vh-280px)]">
      <!-- Canvas Area -->
      <div class="flex-1 min-h-0">
        <div class="bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-200/50 h-full overflow-hidden">
          <!-- Canvas Header -->
          <div class="bg-slate-50/80 backdrop-blur-sm border-b border-slate-200/50 px-6 py-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <h3 class="font-bold text-slate-800 text-lg">Canvas</h3>
                <div class="flex items-center space-x-3 text-sm text-slate-600">
                  <div class="flex items-center space-x-1">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    <span>Live Preview</span>
                  </div>
                </div>
              </div>
              <div class="flex items-center space-x-2">
                <!-- Device Preview Buttons -->
                <div class="flex items-center bg-white rounded-xl border border-slate-200 p-1">
                  <button class="p-2 text-blue-600 bg-blue-50 rounded-lg transition-all duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                      <line x1="8" y1="21" x2="16" y2="21"/>
                      <line x1="12" y1="17" x2="12" y2="21"/>
                    </svg>
                  </button>
                  <button class="p-2 text-slate-400 hover:text-slate-600 transition-colors duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                      <line x1="12" y1="18" x2="12.01" y2="18"/>
                    </svg>
                  </button>
                  <button class="p-2 text-slate-400 hover:text-slate-600 transition-colors duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                      <line x1="12" y1="18" x2="12.01" y2="18"/>
                    </svg>
                  </button>
                </div>
                
                <!-- Zoom Controls -->
                <div class="flex items-center bg-white rounded-xl border border-slate-200 px-3 py-2">
                  <button class="p-1 text-slate-400 hover:text-slate-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="11" cy="11" r="8"/>
                      <path d="M21 21l-4.35-4.35"/>
                      <path d="M8 11h6"/>
                    </svg>
                  </button>
                  <span class="mx-3 text-sm font-medium text-slate-600">100%</span>
                  <button class="p-1 text-slate-400 hover:text-slate-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="11" cy="11" r="8"/>
                      <path d="M21 21l-4.35-4.35"/>
                      <path d="M11 8v6"/>
                      <path d="M8 11h6"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Canvas Content -->
          <div class="p-8 h-full overflow-y-auto bg-gradient-to-br from-slate-50/50 to-blue-50/50">
            <div class="max-w-4xl mx-auto">
              <!-- Drop Zone -->
              <div class="border-2 border-dashed border-slate-300 rounded-3xl p-16 text-center hover:border-blue-400 hover:bg-blue-50/30 transition-all duration-300 group">
                <div class="w-20 h-20 bg-gradient-to-br from-blue-100 via-purple-100 to-pink-100 rounded-3xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-slate-800 mb-3">Start Building Your Template</h3>
                <p class="text-slate-600 mb-8 text-lg max-w-md mx-auto">Drag components from the library or use AI to generate professional content</p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                  <button type="button" class="px-6 py-3 text-sm font-semibold text-blue-600 bg-blue-100 rounded-2xl hover:bg-blue-200 transition-all duration-200 flex items-center space-x-2">
                    <span>📦</span>
                    <span>Browse Components</span>
                  </button>
                  <button type="button" class="px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 rounded-2xl hover:from-blue-700 hover:via-purple-700 hover:to-pink-700 transition-all duration-300 transform hover:scale-105 flex items-center space-x-2 shadow-lg">
                    <span>🤖</span>
                    <span>Generate with AI</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Component Library Sidebar -->
      <div class="w-full xl:w-96 min-h-0">
        <div class="bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl shadow-slate-200/50 border border-slate-200/50 h-full overflow-hidden">
          <!-- Sidebar Tabs -->
          <div class="border-b border-slate-200 bg-white/95 backdrop-blur-xl">
            <nav class="flex px-6 py-4" aria-label="Tabs">
              <button class="library-tab-btn text-blue-600 border-blue-600 whitespace-nowrap py-3 px-4 border-b-2 font-semibold text-sm rounded-t-lg bg-blue-50/50"
                      data-tab="library"
                      onclick="showTab('library')">
                📦 Library
              </button>
              <button class="library-tab-btn text-slate-500 border-transparent hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3 px-4 border-b-2 font-medium text-sm transition-all duration-200"
                      data-tab="ai"
                      onclick="showTab('ai')">
                🤖 AI Generate
              </button>
              <button class="library-tab-btn text-slate-500 border-transparent hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3 px-4 border-b-2 font-medium text-sm transition-all duration-200"
                      data-tab="favorites"
                      onclick="showTab('favorites')">
                ❤️ Favorites
              </button>
            </nav>
          </div>

          <!-- Component Library Tab -->
          <div id="library-tab" class="tab-content p-6 h-full overflow-y-auto">
            <div class="mb-6">
              <h3 class="text-xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent mb-2">Component Library</h3>
              <p class="text-slate-600 text-sm font-medium">Professional components ready to use</p>
            </div>

            <!-- Search and Filter -->
            <div class="space-y-4 mb-6">
              <div class="relative">
                <input type="text"
                       placeholder="Search components..."
                       class="w-full pl-12 pr-4 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 focus:bg-white border border-slate-200 transition-all duration-300 placeholder-slate-400 shadow-sm">
                <div class="absolute left-4 top-1/2 transform -translate-y-1/2">
                  <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
              </div>

              <select class="w-full px-4 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 transition-all duration-300 shadow-sm">
                <option value="all">All Categories</option>
                <option value="headers">📰 Headers</option>
                <option value="content">📝 Content</option>
                <option value="buttons">🔘 Buttons</option>
                <option value="images">🖼️ Images</option>
                <option value="social">📱 Social Media</option>
                <option value="tiktok">🎵 TikTok</option>
                <option value="youtube">📺 YouTube</option>
                <option value="instagram">📸 Instagram</option>
                <option value="ecommerce">🛒 E-commerce</option>
              </select>
            </div>

            <!-- Component Grid -->
            <div class="space-y-4">
              <!-- Sample Components -->
              <div class="component-card bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden hover:shadow-xl hover:scale-105 transition-all duration-300">
                <div class="aspect-w-16 aspect-h-9 bg-gradient-to-br from-blue-100 to-indigo-100 flex items-center justify-center">
                  <div class="text-3xl">📰</div>
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-slate-800 mb-1">Header Section</h3>
                  <p class="text-sm text-slate-600 mb-3">Clean header with logo and navigation</p>
                  <div class="flex space-x-2">
                    <button class="flex-1 px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors duration-200">
                      👁️ Preview
                    </button>
                    <button class="flex-1 px-3 py-2 text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl hover:from-blue-700 hover:to-purple-700 transition-all duration-200">
                      ✨ Use
                    </button>
                  </div>
                </div>
              </div>

              <div class="component-card bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden hover:shadow-xl hover:scale-105 transition-all duration-300">
                <div class="aspect-w-16 aspect-h-9 bg-gradient-to-br from-green-100 to-emerald-100 flex items-center justify-center">
                  <div class="text-3xl">🔘</div>
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-slate-800 mb-1">Call-to-Action</h3>
                  <p class="text-sm text-slate-600 mb-3">Prominent action button with gradient</p>
                  <div class="flex space-x-2">
                    <button class="flex-1 px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors duration-200">
                      👁️ Preview
                    </button>
                    <button class="flex-1 px-3 py-2 text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl hover:from-blue-700 hover:to-purple-700 transition-all duration-200">
                      ✨ Use
                    </button>
                  </div>
                </div>
              </div>

              <!-- Platform-specific Components -->
              <div class="component-card bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden hover:shadow-xl hover:scale-105 transition-all duration-300">
                <div class="aspect-w-9 aspect-h-16 bg-gradient-to-br from-gray-900 to-black flex items-center justify-center relative">
                  <div class="text-3xl">🎵</div>
                  <div class="absolute top-2 right-2">
                    <span class="px-2 py-1 bg-black text-white text-xs font-bold rounded-full">TikTok</span>
                  </div>
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-slate-800 mb-1">TikTok Video</h3>
                  <p class="text-sm text-slate-600 mb-3">Vertical video template with trending effects</p>
                  <div class="flex space-x-2">
                    <button class="flex-1 px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors duration-200">
                      👁️ Preview
                    </button>
                    <button class="flex-1 px-3 py-2 text-sm font-semibold text-white bg-gradient-to-r from-gray-800 to-black rounded-xl hover:from-gray-900 hover:to-gray-800 transition-all duration-200">
                      ✨ Use
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- AI Generate Tab -->
          <div id="ai-tab" class="tab-content hidden p-6 h-full overflow-y-auto">
            <div class="mb-6">
              <h3 class="text-xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent mb-2">AI Template Generator</h3>
              <p class="text-slate-600 text-sm font-medium">Describe what you want and let AI create it</p>
            </div>

            <!-- AI Generation Form -->
            <%= form_with url: generate_ai_template_templates_path, method: :post, local: true, id: "ai-generation-form", class: "space-y-6" do |form| %>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-3">Describe your template</label>
                <%= form.text_area :description,
                    placeholder: "E.g., Create a modern newsletter template for a tech startup with a hero section, product features, and call-to-action...",
                    rows: 4,
                    required: true,
                    class: "w-full px-4 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 transition-all duration-300 placeholder-slate-400 resize-none shadow-sm" %>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-slate-700 mb-2">Platform</label>
                  <%= form.select :platform,
                      options_for_select([
                        ['📧 Email', 'email'],
                        ['🎵 TikTok', 'tiktok'],
                        ['📸 Instagram', 'instagram'],
                        ['📺 YouTube', 'youtube'],
                        ['💼 LinkedIn', 'linkedin'],
                        ['📘 Facebook', 'facebook'],
                        ['🐦 Twitter/X', 'twitter'],
                        ['🌐 Website', 'website']
                      ]),
                      { prompt: 'Select Platform' },
                      { class: "w-full px-4 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 shadow-sm" } %>
                </div>

                <div>
                  <label class="block text-sm font-semibold text-slate-700 mb-2">Content Type</label>
                  <%= form.select :content_type,
                      options_for_select([
                        ['🎯 Promotional', 'promotional'],
                        ['📚 Educational', 'educational'],
                        ['🎭 Entertaining', 'entertaining'],
                        ['🔥 Trending', 'trending'],
                        ['⚡ Viral', 'viral'],
                        ['📖 Story', 'story'],
                        ['🎓 Tutorial', 'tutorial'],
                        ['🎬 Behind Scenes', 'behind_scenes']
                      ]),
                      { prompt: 'Select Content Type' },
                      { class: "w-full px-4 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 shadow-sm" } %>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-slate-700 mb-2">Industry</label>
                  <%= form.select :industry,
                      options_for_select([
                        ['General', 'general'],
                        ['Technology', 'tech'],
                        ['E-commerce', 'ecommerce'],
                        ['Healthcare', 'healthcare'],
                        ['Finance', 'finance'],
                        ['Education', 'education'],
                        ['Fitness & Health', 'fitness'],
                        ['Food & Beverage', 'food'],
                        ['Fashion & Beauty', 'fashion'],
                        ['Travel & Lifestyle', 'travel']
                      ]),
                      { prompt: 'Select Industry' },
                      { class: "w-full px-4 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 shadow-sm" } %>
                </div>

                <div>
                  <label class="block text-sm font-semibold text-slate-700 mb-2">Tone</label>
                  <%= form.select :tone,
                      options_for_select([
                        ['Professional', 'professional'],
                        ['Friendly', 'friendly'],
                        ['Casual', 'casual'],
                        ['Formal', 'formal'],
                        ['Playful', 'playful'],
                        ['Energetic', 'energetic'],
                        ['Trendy', 'trendy'],
                        ['Authentic', 'authentic']
                      ]),
                      { prompt: 'Select Tone' },
                      { class: "w-full px-4 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 shadow-sm" } %>
                </div>
              </div>

              <%= form.submit "✨ Generate Template",
                  class: "w-full px-6 py-4 text-sm font-bold text-white bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 rounded-2xl hover:from-blue-700 hover:via-purple-700 hover:to-pink-700 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl" %>
            <% end %>

            <!-- Loading Indicator -->
            <div class="hidden mt-8 text-center">
              <div class="inline-flex items-center px-6 py-3 text-sm font-semibold text-blue-600 bg-blue-100 rounded-2xl">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Generating your template...
              </div>
            </div>
          </div>

          <!-- Favorites Tab -->
          <div id="favorites-tab" class="tab-content hidden p-6 h-full overflow-y-auto">
            <div class="mb-6">
              <h3 class="text-xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent mb-2">Favorite Components</h3>
              <p class="text-slate-600 text-sm font-medium">Your saved components for quick access</p>
            </div>

            <div class="text-center text-slate-500 py-16">
              <div class="w-20 h-20 bg-gradient-to-br from-blue-100 via-purple-100 to-pink-100 rounded-3xl flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              </div>
              <p class="font-semibold text-lg mb-2">No favorites yet</p>
              <p class="text-sm">Heart components to save them here</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Enhanced JavaScript -->
  <script>
    function showTab(tabName) {
      // Hide all tabs
      document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.add('hidden');
      });

      // Remove active state from all buttons
      document.querySelectorAll('.library-tab-btn').forEach(btn => {
        btn.classList.remove('text-blue-600', 'border-blue-600', 'bg-blue-50/50');
        btn.classList.add('text-slate-500', 'border-transparent');
      });

      // Show selected tab
      document.getElementById(tabName + '-tab').classList.remove('hidden');

      // Add active state to selected button
      const activeBtn = document.querySelector(`[data-tab="${tabName}"]`);
      activeBtn.classList.remove('text-slate-500', 'border-transparent');
      activeBtn.classList.add('text-blue-600', 'border-blue-600', 'bg-blue-50/50');
    }

    function saveDraft() {
      const form = document.getElementById('template-form');
      const formData = new FormData(form);
      formData.append('template[status]', 'draft');
      
      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          showNotification('Draft saved successfully!', 'success');
          updateLastSaved();
        } else {
          showNotification('Error saving draft', 'error');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        showNotification('Error saving draft', 'error');
      });
    }

    function publishTemplate() {
      const form = document.getElementById('template-form');
      const formData = new FormData(form);
      formData.append('template[status]', 'active');
      
      if (!form.querySelector('[name="template[name]"]').value.trim()) {
        showNotification('Please enter a template name', 'error');
        return;
      }
      
      if (!form.querySelector('[name="template[template_type]"]').value) {
        showNotification('Please select a template type', 'error');
        return;
      }
      
      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          showNotification('Template published successfully!', 'success');
          setTimeout(() => {
            window.location.href = data.redirect_url || '<%= templates_path %>';
          }, 1500);
        } else {
          showNotification('Error publishing template', 'error');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        showNotification('Error publishing template', 'error');
      });
    }

    function showNotification(message, type) {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 px-6 py-3 rounded-2xl shadow-lg z-50 transition-all duration-300 ${
        type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
      }`;
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.style.opacity = '0';
        setTimeout(() => {
          document.body.removeChild(notification);
        }, 300);
      }, 3000);
    }

    function updateLastSaved() {
      const now = new Date();
      const timeString = now.toLocaleTimeString('en-US', { 
        hour: '2-digit', 
        minute: '2-digit',
        hour12: false 
      });
      const lastSavedElement = document.querySelector('.text-slate-700.font-semibold');
      if (lastSavedElement) {
        lastSavedElement.textContent = timeString;
      }
    }

    // Auto-save functionality
    let autoSaveTimeout;
    function setupAutoSave() {
      const form = document.getElementById('template-form');
      const inputs = form.querySelectorAll('input, select, textarea');
      
      inputs.forEach(input => {
        input.addEventListener('input', () => {
          clearTimeout(autoSaveTimeout);
          autoSaveTimeout = setTimeout(() => {
            if (document.querySelector('input[type="checkbox"]').checked) {
              saveDraft();
            }
          }, 2000); // Auto-save after 2 seconds of inactivity
        });
      });
    }

    // Initialize auto-save when page loads
    document.addEventListener('DOMContentLoaded', setupAutoSave);
  </script>
</div>