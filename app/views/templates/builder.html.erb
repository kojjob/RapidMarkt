<div class="template-builder"
     data-controller="template-builder" 
     data-template-builder-template-id-value="<%= @template.persisted? ? @template.id : 'new' %>"
     data-template-builder-auto-save-value="true">
  
  <!-- Builder Header -->
  <div class="builder-header">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <h1 class="text-xl font-semibold text-gray-900">
          <%= @template.persisted? ? @template.name : "New Template" %>
        </h1>
        <div class="flex items-center space-x-2">
          <span class="save-status text-sm text-gray-500" data-template-builder-target="saveStatus">
            All changes saved
          </span>
          <% if @template.persisted? %>
            <span class="text-sm ">•</span>
            <span class="text-sm text-gray-500">
              Last updated <%= time_ago_in_words(@template.updated_at) %> ago
            </span>
          <% end %>
        </div>
      </div>
      
      <div class="flex items-center space-x-3">
        <button type="button" 
                class="btn btn-secondary"
                data-action="click->template-builder#preview">
          <i class="fas fa-eye mr-2"></i>Preview
        </button>
        
        <% if current_user&.can_use_ai_features? %>
          <button type="button" 
                  class="btn btn-purple"
                  data-action="click->template-builder#generateAI">
            <i class="fas fa-magic mr-2"></i>AI Generate
          </button>
        <% end %>
        
        <button type="button" 
                class="btn btn-primary"
                data-action="click->template-builder#save">
          <i class="fas fa-save mr-2"></i>Save
        </button>
        
        <div class="relative" data-controller="dropdown">
          <button type="button" 
                  class="btn btn-secondary"
                  data-action="click->dropdown#toggle">
            <i class="fas fa-ellipsis-v"></i>
          </button>
          
          <div class="dropdown-menu hidden" data-dropdown-target="menu">
            <% if @template.persisted? %>
              <%= link_to "Duplicate", duplicate_template_path(@template), 
                  method: :post, class: "dropdown-item" %>
              <div class="dropdown-divider"></div>
              <%= link_to "Delete", @template, 
                  method: :delete, 
                  confirm: "Are you sure?", 
                  class: "dropdown-item text-red-600" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Builder Content -->
  <div class="builder-main">
    <!-- Component Palette -->
    <div class="component-palette">
        <h3>Components</h3>
        
        <div data-template-builder-target="componentPalette">
          <!-- Basic Components -->
          <div class="component-category">
            <h4>Basic</h4>
            
            <div class="component-item" data-component-type="text" draggable="true">
              <i class="fas fa-paragraph"></i>
              <span>Text Block</span>
            </div>
            
            <div class="component-item" data-component-type="header" draggable="true">
              <i class="fas fa-heading"></i>
              <span>Header</span>
            </div>
            
            <div class="component-item" data-component-type="image" draggable="true">
              <i class="fas fa-image"></i>
              <span>Image</span>
            </div>
            
            <div class="component-item" data-component-type="button" draggable="true">
              <i class="fas fa-mouse-pointer"></i>
              <span>Button</span>
            </div>
            
            <div class="component-item" data-component-type="divider" draggable="true">
              <i class="fas fa-minus"></i>
              <span>Divider</span>
            </div>
          </div>

          <!-- Email Components -->
          <div class="component-category">
            <h4>Email</h4>
            
            <div class="component-item" data-component-type="email-header" draggable="true">
              <i class="fas fa-envelope-open"></i>
              <span>Email Header</span>
            </div>
            
            <div class="component-item" data-component-type="cta" draggable="true">
              <i class="fas fa-bullhorn"></i>
              <span>Call to Action</span>
            </div>
            
            <div class="component-item" data-component-type="footer" draggable="true">
              <i class="fas fa-align-center"></i>
              <span>Footer</span>
            </div>
          </div>

          <!-- Social Components -->
          <div class="component-category">
            <h4>Social</h4>
            
            <div class="component-item" data-component-type="social-links" draggable="true">
              <i class="fas fa-share-alt"></i>
              <span>Social Links</span>
            </div>
            
            <div class="component-item" data-component-type="instagram-story" draggable="true">
              <i class="fab fa-instagram"></i>
              <span>Instagram Story</span>
            </div>
            
            <div class="component-item" data-component-type="tiktok-video" draggable="true">
              <i class="fab fa-tiktok"></i>
              <span>TikTok Video</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Builder Canvas -->
    <div class="builder-canvas">
      <div class="canvas-container">
        <div class="canvas-area">
          <!-- Canvas Header -->
          <div class="canvas-header">
            <div class="flex">
              <h3>Template Canvas</h3>
              
              <!-- Device Preview Toggle -->
              <div class="device-preview-toggle">
                <div class="btn-group">
                  <button type="button" class="btn btn-sm active" data-device="desktop">
                    <i class="fas fa-desktop"></i>
                  </button>
                  <button type="button" class="btn btn-sm" data-device="tablet">
                    <i class="fas fa-tablet-alt"></i>
                  </button>
                  <button type="button" class="btn btn-sm" data-device="mobile">
                    <i class="fas fa-mobile-alt"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Canvas Content -->
          <div class="canvas-content">
            <div class="drop-zone"
                 data-template-builder-target="builderArea">
              
              <% if @template.body.present? %>
                <!-- Render existing template content -->
                <div class="existing-content">
                  <%= raw @template.body %>
                </div>
              <% else %>
                <!-- Empty state -->
                <div class="empty-state">
                  <i class="fas fa-plus-circle"></i>
                  <h4>Start building your template</h4>
                  <p>Drag components from the palette to create your template</p>
                  
                  <% if current_user&.can_use_ai_features? %>
                    <button type="button" 
                            class="btn btn-primary"
                            data-action="click->template-builder#showAIModal">
                      <i class="fas fa-magic"></i>Generate with AI
                    </button>
                  <% else %>
                    <p>Or start with a text block or header</p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Properties Panel -->
    <div class="properties-panel">
        <h3>Properties</h3>
        
        <%= form_with model: @template, local: false, 
            id: 'template-form',
            data: { template_builder_target: "form" } do |form| %>
          
          <!-- Template Settings -->
          <div class="form-section">
            <h4>Template Settings</h4>
            
            <div class="form-group">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name, 
                  class: "form-input",
                  placeholder: "Enter template name",
                  data: { action: "input->template-builder#updateName" } %>
            </div>
            
            <div class="form-group">
              <%= form.label :template_type, "Type", class: "form-label" %>
              <%= form.select :template_type, 
                  options_for_select([
                    ['Email', 'email'],
                    ['Social Media', 'social'],
                    ['Instagram Story', 'instagram_story'],
                    ['TikTok Video', 'tiktok_video'],
                    ['LinkedIn Post', 'linkedin_post']
                  ], @template.template_type),
                  { prompt: "Select type" },
                  { class: "form-select" } %>
            </div>
            
            <div class="form-group">
              <%= form.label :status, class: "form-label" %>
              <%= form.select :status, 
                  options_for_select([
                    ['Draft', 'draft'],
                    ['Active', 'active'],
                    ['Archived', 'archived']
                  ], @template.status || 'draft'),
                  {},
                  { class: "form-select" } %>
            </div>
          </div>

          <!-- Content -->
          <div class="form-section">
            <h4>Content</h4>
            
            <div class="form-group">
              <%= form.label :subject, class: "form-label" %>
              <%= form.text_field :subject, 
                  class: "form-input",
                  placeholder: "Email subject or title",
                  data: { template_builder_target: "subject" } %>
            </div>
            
            <div class="form-group">
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, 
                  class: "form-textarea",
                  rows: 3,
                  placeholder: "Template description (internal use)" %>
            </div>
          </div>

          <!-- Hidden field for template body -->
          <%= form.hidden_field :body, data: { template_builder_target: "content" } %>
          
        <% end %>

        <!-- Selected Element Properties -->
        <div class="selected-element-properties" 
             data-template-builder-target="elementProperties"
             style="display: none;">
          <h4 class="text-sm font-medium text-gray-700 mb-3">Element Properties</h4>
          <div class="element-properties-content">
            <!-- Properties will be populated by JavaScript based on selected element -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Preview Modal -->
  <div class="preview-modal hidden" data-template-builder-target="previewModal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Template Preview</h3>
        <button type="button" class="modal-close" data-action="click->template-builder#closePreview">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="preview-content" data-template-builder-target="previewContent">
          <!-- Preview content will be loaded here -->
        </div>
      </div>
    </div>
  </div>

  <!-- AI Generation Modal -->
  <% if current_user&.can_use_ai_features? %>
    <div class="ai-modal hidden" data-template-builder-target="aiModal">
      <div class="modal-backdrop"></div>
      <div class="modal-content">
        <div class="modal-header">
          <h3 class="modal-title">Generate with AI</h3>
          <button type="button" class="modal-close" data-action="click->template-builder#closeAIModal">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="modal-body">
          <%= form_with url: generate_templates_path, local: false, 
              id: 'ai-generation-form',
              data: { template_builder_target: "aiForm" } do |form| %>
            
            <div class="form-group">
              <%= form.label :prompt, "Describe your template", class: "form-label" %>
              <%= form.text_area :prompt, 
                  class: "form-textarea",
                  rows: 3,
                  placeholder: "e.g., Create a welcome email for new customers with a professional tone" %>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="form-group">
                <%= form.label :platform, class: "form-label" %>
                <%= form.select :platform, 
                    options_for_select([
                      ['Email', 'email'],
                      ['Instagram', 'instagram'],
                      ['TikTok', 'tiktok'],
                      ['LinkedIn', 'linkedin']
                    ]),
                    { prompt: "Select platform" },
                    { class: "form-select" } %>
              </div>
              
              <div class="form-group">
                <%= form.label :content_type, "Content Type", class: "form-label" %>
                <%= form.select :content_type, 
                    options_for_select([
                      ['Promotional', 'promotional'],
                      ['Educational', 'educational'],
                      ['Entertaining', 'entertaining'],
                      ['Trending', 'trending']
                    ]),
                    { prompt: "Select type" },
                    { class: "form-select" } %>
              </div>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="form-group">
                <%= form.label :industry, class: "form-label" %>
                <%= form.select :industry, 
                    options_for_select([
                      ['Technology', 'tech'],
                      ['Healthcare', 'healthcare'],
                      ['Finance', 'finance'],
                      ['Retail', 'retail'],
                      ['Education', 'education'],
                      ['Food & Beverage', 'food'],
                      ['Fashion', 'fashion'],
                      ['Fitness', 'fitness']
                    ]),
                    { prompt: "Select industry" },
                    { class: "form-select" } %>
              </div>
              
              <div class="form-group">
                <%= form.label :tone, class: "form-label" %>
                <%= form.select :tone, 
                    options_for_select([
                      ['Professional', 'professional'],
                      ['Friendly', 'friendly'],
                      ['Trendy', 'trendy'],
                      ['Urgent', 'urgent'],
                      ['Casual', 'casual']
                    ]),
                    { prompt: "Select tone" },
                    { class: "form-select" } %>
              </div>
            </div>
            
            <div class="flex justify-end space-x-3">
              <button type="button" 
                      class="btn btn-secondary"
                      data-action="click->template-builder#closeAIModal">
                Cancel
              </button>
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-magic mr-2"></i>Generate Template
              </button>
            </div>
            
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
/* Modern Template Builder Styles */
:root {
  --primary: #4F46E5;
  --primary-hover: #4338CA;
  --primary-light: #EEF2FF;
  --secondary: #6B7280;
  --success: #10B981;
  --danger: #EF4444;
  --warning: #F59E0B;
  --bg-primary: #FFFFFF;
  --bg-secondary: #F8FAFC;
  --bg-tertiary: #F1F5F9;
  --border: #E2E8F0;
  --border-light: #F1F5F9;
  --text-primary: #0F172A;
  --text-secondary: #475569;
  --text-muted: #94A3B8;
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --radius: 8px;
  --radius-lg: 12px;
}

.template-builder {
  height: 100vh;
  background: var(--bg-secondary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
}

/* Header */
.builder-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(8px);
  padding: 16px 24px;
}

.builder-header h1 {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.save-status {
  font-size: 14px;
  color: var(--text-muted);
}

.save-status.saved {
  color: var(--success);
}

.save-status.unsaved {
  color: var(--warning);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  padding: 8px 16px;
  border-radius: var(--radius);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn:focus {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

.btn-primary {
  background: var(--primary);
  color: white;
}

.btn-primary:hover {
  background: var(--primary-hover);
}

.btn-secondary {
  background: var(--bg-primary);
  color: var(--text-secondary);
  border: 1px solid var(--border);
}

.btn-secondary:hover {
  background: var(--bg-tertiary);
}

.btn-purple {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-purple:hover {
  opacity: 0.9;
}

/* Main Layout */
.builder-main {
  display: flex;
  margin-top: 72px;
  height: calc(100vh - 72px);
}

/* Component Palette */
.component-palette {
  width: 280px;
  background: var(--bg-primary);
  border-right: 1px solid var(--border);
  height: 100%;
  overflow-y: auto;
}

.component-palette h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 16px 0;
  padding: 24px 24px 0 24px;
}

.component-category {
  margin-bottom: 24px;
  padding: 0 24px;
}

.component-category:not(:first-child) {
  margin-top: 24px;
}

.component-category h4 {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 12px 0;
}

.component-item {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  border-radius: var(--radius);
  cursor: grab;
  transition: all 0.2s ease;
  margin-bottom: 4px;
}

.component-item:hover {
  background: var(--bg-tertiary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}

.component-item:active {
  cursor: grabbing;
  transform: scale(0.98);
}

.component-item i {
  color: var(--text-muted);
  width: 20px;
  text-align: center;
}

.component-item span {
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 500;
  margin-left: 12px;
}

/* Builder Canvas */
.builder-canvas {
  flex: 1;
  background: var(--bg-secondary);
  overflow: auto;
  position: relative;
}

.canvas-container {
  padding: 32px;
  max-width: 800px;
  margin: 0 auto;
}

.canvas-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.canvas-header h3 {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.device-preview-toggle .btn-group {
  display: flex;
  background: var(--bg-primary);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  overflow: hidden;
}

.device-preview-toggle .btn {
  padding: 8px 12px;
  border: none;
  background: transparent;
  color: var(--text-muted);
  border-radius: 0;
}

.device-preview-toggle .btn.active {
  background: var(--primary);
  color: white;
}

/* Drop Zone */
.drop-zone {
  background: var(--bg-primary);
  border: 2px dashed var(--border);
  border-radius: var(--radius-lg);
  min-height: 500px;
  padding: 48px 32px;
  text-align: center;
  transition: all 0.3s ease;
}

.drop-zone.drag-over {
  border-color: var(--primary);
  background: var(--primary-light);
  transform: scale(1.02);
}

.empty-state i {
  font-size: 48px;
  color: var(--text-muted);
  margin-bottom: 16px;
}

.empty-state h4 {
  font-size: 20px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 8px 0;
}

.empty-state p {
  color: var(--text-muted);
  margin: 0 0 24px 0;
}

/* Properties Panel */
.properties-panel {
  width: 320px;
  background: var(--bg-primary);
  border-left: 1px solid var(--border);
  height: 100%;
  overflow-y: auto;
}

.properties-panel h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 16px 0;
  padding: 24px 24px 0 24px;
}

.form-section {
  padding: 0 24px 24px 24px;
  border-bottom: 1px solid var(--border-light);
  margin-bottom: 24px;
}

.form-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.form-section h4 {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 16px 0;
}

.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.form-input, .form-select, .form-textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 14px;
  background: var(--bg-primary);
  transition: all 0.2s ease;
}

.form-input:focus, .form-select:focus, .form-textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--primary-light);
}

/* Modals */
.ai-modal, .preview-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  cursor: pointer;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  max-width: 90vw;
  max-height: 90vh;
  overflow: auto;
  cursor: default;
  width: 600px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 24px 0 24px;
  margin-bottom: 24px;
}

.modal-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.modal-close {
  background: none;
  border: none;
  font-size: 20px;
  color: var(--text-muted);
  cursor: pointer;
  padding: 8px;
  border-radius: var(--radius);
  transition: all 0.2s ease;
}

.modal-close:hover {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}

.modal-body {
  padding: 0 24px 24px 24px;
}

.grid {
  display: grid;
}

.grid-cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.gap-4 {
  gap: 16px;
}

.mb-4 {
  margin-bottom: 16px;
}

.mb-6 {
  margin-bottom: 24px;
}

.space-x-3 > * + * {
  margin-left: 12px;
}

.justify-end {
  justify-content: flex-end;
}

.flex {
  display: flex;
}

.items-center {
  align-items: center;
}

.hidden {
  display: none !important;
}

/* Scrollbar Styling */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: var(--bg-secondary);
}

::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--text-muted);
}

/* Drag and Drop */
.sortable-ghost {
  opacity: 0.4;
  background: var(--primary-light);
  border: 2px dashed var(--primary);
}

.sortable-chosen {
  cursor: grabbing;
}

.sortable-drag {
  transform: rotate(5deg);
  box-shadow: var(--shadow-lg);
}

/* Builder Components */
.builder-component {
  position: relative;
  margin: 16px 0;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-primary);
  transition: all 0.2s ease;
}

.builder-component:hover {
  border-color: var(--primary);
