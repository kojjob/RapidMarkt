<!-- Desktop Sidebar -->
<div class="hidden md:flex md:w-64 md:flex-col" data-controller="sidebar">
  <div class="flex flex-col flex-grow bg-gradient-to-b from-slate-900 to-slate-800 shadow-xl">
    <!-- Logo Section -->
    <div class="flex items-center flex-shrink-0 px-6 py-6 border-b border-slate-700">
      <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
        <div class="w-8 h-8 bg-gradient-to-br from-indigo-400 to-purple-500 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <span class="text-xl font-bold text-white group-hover:text-indigo-300 transition-colors">RapidMarkt</span>
      <% end %>
    </div>
    
    <!-- Navigation -->
    <div class="flex-1 flex flex-col overflow-y-auto">
      <nav class="flex-1 px-4 py-6 space-y-8">
        
        <!-- Main Section -->
        <div>
          <h3 class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Overview</h3>
          <div class="space-y-1">
            <%= link_to dashboard_path, class: "#{current_page?(dashboard_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(dashboard_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v6H8V5z" />
              </svg>
              <span class="flex-1">Dashboard</span>
              <% if current_page?(dashboard_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
            
            <%= link_to analytics_path, class: "#{current_page?(analytics_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(analytics_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <span class="flex-1">Analytics</span>
              <% if current_page?(analytics_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
            
            <%= link_to ai_dashboard_path, class: "#{current_page?(ai_dashboard_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(ai_dashboard_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="flex-1">AI Dashboard</span>
              <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">AI</span>
              <% if current_page?(ai_dashboard_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
          </div>
        </div>
        
        <!-- Marketing Section -->
        <div>
          <h3 class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Marketing</h3>
          <div class="space-y-1">
            <%= link_to campaigns_path, class: "#{current_page?(campaigns_path) || current_page?(new_campaign_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(campaigns_path) || current_page?(new_campaign_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
              </svg>
              <span class="flex-1">Campaigns</span>
              <% if current_page?(campaigns_path) || current_page?(new_campaign_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
            
            <%= link_to contacts_path, class: "#{current_page?(contacts_path) || current_page?(new_contact_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(contacts_path) || current_page?(new_contact_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <span class="flex-1">Contacts</span>
              <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 rounded-full">24</span>
            <% end %>
            
            <%= link_to templates_path, class: "#{current_page?(templates_path) || current_page?(new_template_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(templates_path) || current_page?(new_template_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span class="flex-1">Templates</span>
              <% if current_page?(templates_path) || current_page?(new_template_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
          </div>
        </div>
        
        <!-- Automation Section -->
        <div>
          <h3 class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Automation</h3>
          <div class="space-y-1">
            <%= link_to automations_path, class: "#{current_page?(automations_path) || current_page?(new_automation_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(automations_path) || current_page?(new_automation_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="flex-1">Automations</span>
              <% if current_page?(automations_path) || current_page?(new_automation_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
            
            <%= link_to brand_voices_path, class: "#{current_page?(brand_voices_path) || current_page?(new_brand_voice_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(brand_voices_path) || current_page?(new_brand_voice_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
              <span class="flex-1">Brand Voices</span>
              <% if current_page?(brand_voices_path) || current_page?(new_brand_voice_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
            
            <%= link_to tags_path, class: "#{current_page?(tags_path) || current_page?(new_tag_path) ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-300 hover:bg-slate-700 hover:text-white'} group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
              <svg class="#{current_page?(tags_path) || current_page?(new_tag_path) ? 'text-white' : 'text-slate-400 group-hover:text-white'} mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <span class="flex-1">Tags</span>
              <% if current_page?(tags_path) || current_page?(new_tag_path) %>
                <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
              <% end %>
            <% end %>
          </div>
        </div>
        
        <!-- Admin Section (Role-aware) -->
        <% if current_user.admin? %>
          <div>
            <h3 class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Administration</h3>
            <div class="space-y-1">
              <%= link_to team_account_path, class: "text-slate-300 hover:bg-slate-700 hover:text-white group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
                <svg class="text-slate-400 group-hover:text-white mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                </svg>
                <span class="flex-1">Team Management</span>
                <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-800 rounded-full">Admin</span>
              <% end %>
              
              <% if current_user.owner? %>
                <%= link_to billing_account_path, class: "text-slate-300 hover:bg-slate-700 hover:text-white group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-200" do %>
                  <svg class="text-slate-400 group-hover:text-white mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                  <span class="flex-1">Billing & Plans</span>
                  <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium bg-purple-100 text-purple-800 rounded-full">Owner</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </nav>
      
      <!-- Quick Actions -->
      <div class="px-4 py-4 border-t border-slate-700">
        <div class="grid grid-cols-3 gap-2">
          <%= link_to new_campaign_path, class: "flex flex-col items-center p-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 transition-colors group", title: "New Campaign" do %>
            <svg class="h-4 w-4 text-white mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span class="text-xs text-white font-medium">Campaign</span>
          <% end %>
          
          <%= link_to new_template_path, class: "flex flex-col items-center p-2 rounded-lg bg-purple-600 hover:bg-purple-700 transition-colors group", title: "New Template" do %>
            <svg class="h-4 w-4 text-white mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="text-xs text-white font-medium">Template</span>
          <% end %>
          
          <%= link_to new_contact_path, class: "flex flex-col items-center p-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 transition-colors group", title: "Add Contact" do %>
            <svg class="h-4 w-4 text-white mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="text-xs text-white font-medium">Contact</span>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- User Profile Section -->
    <div class="flex-shrink-0 border-t border-slate-700 p-4">
      <div class="flex-shrink-0 w-full group" data-controller="dropdown">
        <div class="flex items-center">
          <div class="relative">
            <div class="h-10 w-10 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 flex items-center justify-center ring-2 ring-slate-600">
              <span class="text-sm font-medium text-white">
                <%= current_user.first_name&.first || current_user.email.first.upcase %>
              </span>
            </div>
            <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-400 border-2 border-slate-800 rounded-full"></div>
          </div>
          <div class="ml-3 flex-1 min-w-0">
            <p class="text-sm font-medium text-white truncate">
              <%= current_user.first_name || current_user.email.split('@').first %>
            </p>
            <div class="flex items-center space-x-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-700 text-slate-300">
                <%= current_user.role.capitalize %>
              </span>
              <button type="button" class="text-xs font-medium text-slate-400 hover:text-white flex items-center transition-colors"
                      data-action="click->dropdown#toggle"
                      aria-expanded="false"
                      aria-haspopup="true">
                Settings
                <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
          </div>
        </div>
        
        <div class="origin-bottom-left absolute bottom-full left-4 mb-2 w-56 rounded-lg shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50"
             data-dropdown-target="menu"
             role="menu"
             aria-orientation="vertical">
          <div class="py-1" role="none">
            <%= link_to account_path, 
                class: "group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                role: "menuitem" do %>
              <svg class="mr-3 h-4 w-4 text-gray-400 group-hover:text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Account Settings
            <% end %>
            
            <% if current_user.admin? %>
              <%= link_to team_account_path, 
                  class: "group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                  role: "menuitem" do %>
                <svg class="mr-3 h-4 w-4 text-gray-400 group-hover:text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                </svg>
                Team Management
              <% end %>
            <% end %>
            
            <% if current_user.owner? %>
              <%= link_to billing_account_path, 
                  class: "group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                  role: "menuitem" do %>
                <svg class="mr-3 h-4 w-4 text-gray-400 group-hover:text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
                Billing & Plans
              <% end %>
            <% end %>
            
            <hr class="my-1">
            
            <%= link_to "#", 
                class: "group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                role: "menuitem" do %>
              <svg class="mr-3 h-4 w-4 text-gray-400 group-hover:text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Help & Support
            <% end %>
            
            <%= link_to destroy_user_session_path, 
                data: { turbo_method: :delete },
                class: "group flex items-center px-4 py-2 text-sm text-red-700 hover:bg-red-50", 
                role: "menuitem" do %>
              <svg class="mr-3 h-4 w-4 text-red-500 group-hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Sign Out
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>