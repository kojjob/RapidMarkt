<!-- Mobile sidebar -->
<div class="md:hidden" data-controller="mobile-sidebar">
  <!-- Mobile menu button -->
  <div class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between h-16 bg-white border-b border-gray-200 px-4">
    <div class="flex items-center">
      <button type="button" 
              class="p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-md focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500 transition-colors duration-200" 
              data-action="click->mobile-sidebar#toggle"
              data-mobile-sidebar-target="menuButton"
              aria-controls="mobile-sidebar" 
              aria-expanded="false"
              aria-label="Open navigation menu">
        <span class="sr-only">Open sidebar</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <%= link_to root_path, class: "ml-4 text-xl font-bold text-indigo-600" do %>
        RapidMarkt
      <% end %>
    </div>
    
    <!-- Mobile user menu -->
    <div class="flex items-center" data-controller="dropdown">
      <button class="flex items-center text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              data-action="click->dropdown#toggle"
              aria-expanded="false"
              aria-haspopup="true">
        <span class="sr-only">Open user menu</span>
        <div class="h-8 w-8 rounded-full bg-indigo-500 flex items-center justify-center">
          <span class="text-xs font-medium text-white">
            <%= current_user.first_name&.first || current_user.email.first.upcase %>
          </span>
        </div>
      </button>
      
      <div class="origin-top-right absolute top-12 right-4 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50"
           data-dropdown-target="menu"
           role="menu"
           aria-orientation="vertical">
        <div class="py-1" role="none">
          <%= link_to "Account Settings", account_path, 
              class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
              role: "menuitem" %>
          <%= link_to "Team", team_account_path, 
              class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
              role: "menuitem" %>
          <%= link_to "Billing", billing_account_path, 
              class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
              role: "menuitem" %>
          <hr class="my-1">
          <%= link_to "Sign out", destroy_user_session_path, 
              data: { turbo_method: :delete },
              class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
              role: "menuitem" %>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Mobile sidebar overlay -->
  <div class="fixed inset-0 z-30 bg-gray-600 bg-opacity-75 hidden transition-opacity duration-300 ease-in-out opacity-0" 
       data-mobile-sidebar-target="overlay"
       data-action="click->mobile-sidebar#close"></div>
  
  <!-- Mobile sidebar -->
  <div class="fixed inset-y-0 left-0 z-40 w-64 bg-white transform -translate-x-full transition-all duration-300 ease-in-out shadow-2xl" 
       data-mobile-sidebar-target="sidebar"
       role="dialog"
       aria-modal="true"
       aria-label="Navigation menu">
    <div class="flex flex-col h-full pt-16">
      <!-- Mobile sidebar header with close button -->
      <div class="flex items-center justify-between px-4 py-2 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Menu</h2>
        <button type="button" 
                class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                data-action="click->mobile-sidebar#close"
                aria-label="Close menu">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <!-- Search Section -->
      <div class="px-4 py-3 border-b border-gray-200">
        <div class="relative">
          <input type="text" 
                 placeholder="Search navigation..." 
                 class="w-full pl-10 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                 data-mobile-sidebar-target="searchInput"
                 data-action="input->mobile-sidebar#search keydown->mobile-sidebar#handleSearchKeydown">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <button type="button" 
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 hidden"
                  data-mobile-sidebar-target="clearSearch"
                  data-action="click->mobile-sidebar#clearSearch">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="px-4 py-3 border-b border-gray-100">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Quick Actions</h3>
          <div class="flex items-center text-xs text-gray-400">
            <svg class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Swipe left to close
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <%= link_to new_campaign_path, class: "flex flex-col items-center p-3 rounded-lg bg-indigo-50 hover:bg-indigo-100 transition-colors group" do %>
            <div class="flex items-center justify-center w-8 h-8 bg-indigo-500 rounded-lg mb-1 group-hover:bg-indigo-600 transition-colors">
              <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </div>
            <span class="text-xs font-medium text-gray-700">New Campaign</span>
          <% end %>
          
          <%= link_to new_template_path, class: "flex flex-col items-center p-3 rounded-lg bg-purple-50 hover:bg-purple-100 transition-colors group" do %>
            <div class="flex items-center justify-center w-8 h-8 bg-purple-500 rounded-lg mb-1 group-hover:bg-purple-600 transition-colors">
              <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <span class="text-xs font-medium text-gray-700">New Template</span>
          <% end %>
          
          <%= link_to new_contact_path, class: "flex flex-col items-center p-3 rounded-lg bg-green-50 hover:bg-green-100 transition-colors group" do %>
            <div class="flex items-center justify-center w-8 h-8 bg-green-500 rounded-lg mb-1 group-hover:bg-green-600 transition-colors">
              <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <span class="text-xs font-medium text-gray-700">Add Contact</span>
          <% end %>
        </div>
      </div>
      
      <!-- Navigation Sections -->
      <div class="flex-1 py-2 overflow-y-auto" data-mobile-sidebar-target="navigationList">
        <%= render 'shared/mobile_navigation' %>
      </div>
    </div>
  </div>
</div>