<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "RapidMarkt - AI Marketing Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <% if user_signed_in? %>
      <div class="flex h-screen bg-gray-50">
        <!-- Sidebar -->
        <div class="hidden md:flex md:w-64 md:flex-col">
          <div class="flex flex-col flex-grow pt-5 bg-white overflow-y-auto border-r border-gray-200">
            <!-- Logo -->
            <div class="flex items-center flex-shrink-0 px-4">
              <%= link_to root_path, class: "text-2xl font-bold text-indigo-600" do %>
                RapidMarkt
              <% end %>
            </div>
            
            <!-- Navigation -->
            <div class="mt-8 flex-grow flex flex-col">
              <nav class="flex-1 px-2 space-y-1">
                <!-- Dashboard -->
                <%= link_to dashboard_path, class: "#{current_page?(dashboard_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(dashboard_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v6H8V5z" />
                  </svg>
                  Dashboard
                <% end %>
                
                <!-- Campaigns -->
                <%= link_to campaigns_path, class: "#{current_page?(campaigns_path) || current_page?(new_campaign_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(campaigns_path) || current_page?(new_campaign_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                  </svg>
                  Campaigns
                <% end %>
                
                <!-- Contacts -->
                <%= link_to contacts_path, class: "#{current_page?(contacts_path) || current_page?(new_contact_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(contacts_path) || current_page?(new_contact_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  Contacts
                <% end %>
                
                <!-- Templates -->
                <%= link_to templates_path, class: "#{current_page?(templates_path) || current_page?(new_template_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(templates_path) || current_page?(new_template_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  Templates
                <% end %>
                
                <!-- Automations -->
                <%= link_to automations_path, class: "#{current_page?(automations_path) || current_page?(new_automation_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(automations_path) || current_page?(new_automation_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Automations
                <% end %>
                
                <!-- Brand Voices -->
                <%= link_to brand_voices_path, class: "#{current_page?(brand_voices_path) || current_page?(new_brand_voice_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(brand_voices_path) || current_page?(new_brand_voice_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                  </svg>
                  Brand Voices
                <% end %>
                
                <!-- Tags -->
                <%= link_to tags_path, class: "#{current_page?(tags_path) || current_page?(new_tag_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(tags_path) || current_page?(new_tag_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                  </svg>
                  Tags
                <% end %>
                
                <!-- Analytics -->
                <%= link_to analytics_path, class: "#{current_page?(analytics_path) ? 'bg-indigo-100 border-r-2 border-indigo-500 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-sm font-medium rounded-md" do %>
                  <svg class="#{current_page?(analytics_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                  Analytics
                <% end %>
              </nav>
            </div>
            
            <!-- User Menu -->
            <div class="flex-shrink-0 flex border-t border-gray-200 p-4">
              <div class="flex-shrink-0 w-full group block" data-controller="dropdown">
                <div class="flex items-center">
                  <div class="inline-block h-9 w-9 rounded-full bg-indigo-500 flex items-center justify-center">
                    <span class="text-sm font-medium text-white">
                      <%= current_user.first_name&.first || current_user.email.first.upcase %>
                    </span>
                  </div>
                  <div class="ml-3 flex-1">
                    <p class="text-sm font-medium text-gray-700 group-hover:text-gray-900">
                      <%= current_user.first_name || current_user.email.split('@').first %>
                    </p>
                    <button class="text-xs font-medium text-gray-500 group-hover:text-gray-700 flex items-center"
                            data-action="click->dropdown#toggle"
                            aria-expanded="false"
                            aria-haspopup="true">
                      View profile
                      <svg class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </button>
                  </div>
                </div>
                
                <div class="origin-bottom-left absolute bottom-16 left-4 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50"
                     data-dropdown-target="menu"
                     role="menu"
                     aria-orientation="vertical">
                  <div class="py-1" role="none">
                    <%= link_to "Account Settings", account_path, 
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                        role: "menuitem" %>
                    <%= link_to "Team", team_account_path, 
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                        role: "menuitem" %>
                    <%= link_to "Billing", billing_account_path, 
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                        role: "menuitem" %>
                    <hr class="my-1">
                    <%= link_to "Sign out", destroy_user_session_path, 
                        data: { turbo_method: :delete },
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                        role: "menuitem" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Mobile sidebar -->
        <div class="md:hidden" data-controller="mobile-sidebar">
          <!-- Mobile menu button -->
          <div class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between h-16 bg-white border-b border-gray-200 px-4">
            <div class="flex items-center">
              <button type="button" 
                      class="p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-md focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500 transition-colors duration-200" 
                      data-action="click->mobile-sidebar#toggle"
                      data-mobile-sidebar-target="menuButton"
                      aria-controls="mobile-sidebar" 
                      aria-expanded="false"
                      aria-label="Open navigation menu">
                <span class="sr-only">Open sidebar</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </button>
              <%= link_to root_path, class: "ml-4 text-xl font-bold text-indigo-600" do %>
                RapidMarkt
              <% end %>
            </div>
            
            <!-- Mobile user menu -->
            <div class="flex items-center" data-controller="dropdown">
              <button class="flex items-center text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                      data-action="click->dropdown#toggle"
                      aria-expanded="false"
                      aria-haspopup="true">
                <span class="sr-only">Open user menu</span>
                <div class="h-8 w-8 rounded-full bg-indigo-500 flex items-center justify-center">
                  <span class="text-xs font-medium text-white">
                    <%= current_user.first_name&.first || current_user.email.first.upcase %>
                  </span>
                </div>
              </button>
              
              <div class="origin-top-right absolute top-12 right-4 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50"
                   data-dropdown-target="menu"
                   role="menu"
                   aria-orientation="vertical">
                <div class="py-1" role="none">
                  <%= link_to "Account Settings", account_path, 
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                      role: "menuitem" %>
                  <%= link_to "Team", team_account_path, 
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                      role: "menuitem" %>
                  <%= link_to "Billing", billing_account_path, 
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                      role: "menuitem" %>
                  <hr class="my-1">
                  <%= link_to "Sign out", destroy_user_session_path, 
                      data: { turbo_method: :delete },
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                      role: "menuitem" %>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Mobile sidebar overlay -->
          <div class="fixed inset-0 z-30 bg-gray-600 bg-opacity-75 hidden transition-opacity duration-300 ease-in-out opacity-0" 
               data-mobile-sidebar-target="overlay"
               data-action="click->mobile-sidebar#close"></div>
          
          <!-- Mobile sidebar -->
          <div class="fixed inset-y-0 left-0 z-40 w-64 bg-white transform -translate-x-full transition-all duration-300 ease-in-out shadow-2xl" 
               data-mobile-sidebar-target="sidebar"
               role="dialog"
               aria-modal="true"
               aria-label="Navigation menu">
            <div class="flex flex-col h-full pt-16">
              <!-- Mobile sidebar header with close button -->
              <div class="flex items-center justify-between px-4 py-2 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Menu</h2>
                <button type="button" 
                        class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        data-action="click->mobile-sidebar#close"
                        aria-label="Close menu">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              
              <!-- Search Section -->
              <div class="px-4 py-3 border-b border-gray-200">
                <div class="relative">
                  <input type="text" 
                         placeholder="Search navigation..." 
                         class="w-full pl-10 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                         data-mobile-sidebar-target="searchInput"
                         data-action="input->mobile-sidebar#search keydown->mobile-sidebar#handleSearchKeydown">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                  </div>
                  <button type="button" 
                          class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 hidden"
                          data-mobile-sidebar-target="clearSearch"
                          data-action="click->mobile-sidebar#clearSearch">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Quick Actions -->
              <div class="px-4 py-3 border-b border-gray-100">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Quick Actions</h3>
                  <div class="flex items-center text-xs text-gray-400">
                    <svg class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
                    </svg>
                    Swipe left to close
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <%= link_to new_campaign_path, class: "flex flex-col items-center p-3 rounded-lg bg-indigo-50 hover:bg-indigo-100 transition-colors group" do %>
                    <div class="flex items-center justify-center w-8 h-8 bg-indigo-500 rounded-lg mb-1 group-hover:bg-indigo-600 transition-colors">
                      <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                      </svg>
                    </div>
                    <span class="text-xs font-medium text-gray-700">New Campaign</span>
                  <% end %>
                  
                  <%= link_to new_template_path, class: "flex flex-col items-center p-3 rounded-lg bg-purple-50 hover:bg-purple-100 transition-colors group" do %>
                    <div class="flex items-center justify-center w-8 h-8 bg-purple-500 rounded-lg mb-1 group-hover:bg-purple-600 transition-colors">
                      <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <span class="text-xs font-medium text-gray-700">New Template</span>
                  <% end %>
                  
                  <%= link_to new_contact_path, class: "flex flex-col items-center p-3 rounded-lg bg-green-50 hover:bg-green-100 transition-colors group" do %>
                    <div class="flex items-center justify-center w-8 h-8 bg-green-500 rounded-lg mb-1 group-hover:bg-green-600 transition-colors">
                      <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    </div>
                    <span class="text-xs font-medium text-gray-700">Add Contact</span>
                  <% end %>
                </div>
              </div>
              
              <!-- Navigation Sections -->
              <div class="flex-1 py-2 overflow-y-auto" data-mobile-sidebar-target="navigationList">
                <!-- Main Navigation -->
                <div class="px-2 mb-4">
                  <h4 class="px-2 mb-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">Main</h4>
                  <div class="space-y-1">
                    <%= link_to dashboard_path, 
                        class: "#{current_page?(dashboard_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md transition-colors",
                        data: { search_terms: "dashboard home overview analytics stats" } do %>
                      <svg class="#{current_page?(dashboard_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v6H8V5z" />
                      </svg>
                      <span class="flex-1">Dashboard</span>
                    <% end %>
                    
                    <%= link_to analytics_path, 
                        class: "#{current_page?(analytics_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md transition-colors",
                        data: { search_terms: "analytics reports stats metrics performance data insights" } do %>
                      <svg class="#{current_page?(analytics_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                      </svg>
                      <span class="flex-1">Analytics</span>
                    <% end %>
                  </div>
                </div>

                <!-- Marketing Navigation -->
                <div class="px-2 mb-4">
                  <h4 class="px-2 mb-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">Marketing</h4>
                  <div class="space-y-1">
                    <%= link_to campaigns_path, 
                        class: "#{current_page?(campaigns_path) || current_page?(new_campaign_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md transition-colors",
                        data: { search_terms: "campaigns marketing email promotions outreach" } do %>
                  <svg class="#{current_page?(campaigns_path) || current_page?(new_campaign_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                  </svg>
                  Campaigns
                <% end %>
                
                    <%= link_to contacts_path, 
                        class: "#{current_page?(contacts_path) || current_page?(new_contact_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md transition-colors",
                        data: { search_terms: "contacts people customers users audience list" } do %>
                      <svg class="#{current_page?(contacts_path) || current_page?(new_contact_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                      </svg>
                      <span class="flex-1">Contacts</span>
                      <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-green-100 bg-green-600 rounded-full">24</span>
                    <% end %>
                
                <%= link_to templates_path, class: "#{current_page?(templates_path) || current_page?(new_template_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md" do %>
                  <svg class="#{current_page?(templates_path) || current_page?(new_template_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  Templates
                <% end %>
                
                <%= link_to automations_path, class: "#{current_page?(automations_path) || current_page?(new_automation_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md" do %>
                  <svg class="#{current_page?(automations_path) || current_page?(new_automation_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Automations
                <% end %>
                
                <%= link_to brand_voices_path, class: "#{current_page?(brand_voices_path) || current_page?(new_brand_voice_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md" do %>
                  <svg class="#{current_page?(brand_voices_path) || current_page?(new_brand_voice_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                  </svg>
                  Brand Voices
                <% end %>
                
                <%= link_to tags_path, class: "#{current_page?(tags_path) || current_page?(new_tag_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md" do %>
                  <svg class="#{current_page?(tags_path) || current_page?(new_tag_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                  </svg>
                  Tags
                <% end %>
                
                <%= link_to analytics_path, class: "#{current_page?(analytics_path) ? 'bg-indigo-100 text-indigo-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} group flex items-center px-2 py-2 text-base font-medium rounded-md" do %>
                  <svg class="#{current_page?(analytics_path) ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'} mr-3 flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                  Analytics
                <% end %>
              </div>
              
              <!-- User Context & Quick Settings -->
              <div class="px-2 mt-6 border-t border-gray-200 pt-4">
                <h4 class="px-2 mb-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Account & Settings</h4>
                
                <!-- User Info Card -->
                <div class="mb-4 p-3 bg-gradient-to-r from-indigo-50 to-purple-50 rounded-lg border border-indigo-100">
                  <div class="flex items-center">
                    <div class="flex-shrink-0">
                      <div class="h-10 w-10 rounded-full bg-indigo-500 flex items-center justify-center">
                        <span class="text-sm font-medium text-white">
                          <%= current_user.first_name&.first || current_user.email.first.upcase %>
                        </span>
                      </div>
                    </div>
                    <div class="ml-3 flex-1 min-w-0">
                      <p class="text-sm font-medium text-gray-900 truncate">
                        <%= current_user.first_name || current_user.email.split('@').first %>
                      </p>
                      <p class="text-xs text-gray-500 truncate">
                        <%= current_user.email %>
                      </p>
                    </div>
                    <div class="flex-shrink-0">
                      <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                    </div>
                  </div>
                </div>
                
                <!-- Quick Settings -->
                <div class="space-y-1">
                  <%= link_to account_path, 
                      class: "text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors",
                      data: { search_terms: "account settings profile preferences" } do %>
                    <svg class="text-gray-400 group-hover:text-gray-500 mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="flex-1">Settings</span>
                  <% end %>
                  
                  <%= link_to team_account_path, 
                      class: "text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors",
                      data: { search_terms: "team members collaboration users" } do %>
                    <svg class="text-gray-400 group-hover:text-gray-500 mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                    </svg>
                    <span class="flex-1">Team</span>
                    <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-blue-100 bg-blue-600 rounded-full">Pro</span>
                  <% end %>
                  
                  <%= link_to billing_account_path, 
                      class: "text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors",
                      data: { search_terms: "billing subscription payment plan upgrade" } do %>
                    <svg class="text-gray-400 group-hover:text-gray-500 mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span class="flex-1">Billing</span>
                  <% end %>
                </div>
                
                <!-- Sign Out -->
                <div class="mt-4 pt-4 border-t border-gray-200">
                  <%= link_to destroy_user_session_path, 
                      method: :delete,
                      class: "text-red-600 hover:bg-red-50 hover:text-red-700 group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors",
                      data: { 
                        search_terms: "logout sign out exit quit",
                        confirm: "Are you sure you want to sign out?"
                      } do %>
                    <svg class="text-red-500 group-hover:text-red-600 mr-3 flex-shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="flex-1">Sign Out</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Main content area -->
        <div class="flex-1 flex flex-col overflow-hidden">
      
          <!-- Flash Messages -->
          <% if notice %>
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded relative mx-4 mt-4" 
                 data-controller="flash" 
                 data-flash-auto-dismiss-value="true">
              <span class="block sm:inline"><%= notice %></span>
              <span class="absolute top-0 bottom-0 right-0 px-4 py-3" data-action="click->flash#dismiss">
                <svg class="fill-current h-6 w-6 text-green-500" role="button" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <title>Close</title>
                  <path d="M14.348 14.849a1.2 1.2 0 0 1-1.697 0L10 11.819l-2.651 3.029a1.2 1.2 0 1 1-1.697-1.697l2.758-3.15-2.759-3.152a1.2 1.2 0 1 1 1.697-1.697L10 8.183l2.651-3.031a1.2 1.2 0 1 1 1.697 1.697l-2.758 3.152 2.758 3.15a1.2 1.2 0 0 1 0 1.698z"/>
                </svg>
              </span>
            </div>
          <% end %>
          
          <% if alert %>
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded relative mx-4 mt-4" 
                 data-controller="flash" 
                 data-flash-auto-dismiss-value="true">
              <span class="block sm:inline"><%= alert %></span>
              <span class="absolute top-0 bottom-0 right-0 px-4 py-3" data-action="click->flash#dismiss">
                <svg class="fill-current h-6 w-6 text-red-500" role="button" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <title>Close</title>
                  <path d="M14.348 14.849a1.2 1.2 0 0 1-1.697 0L10 11.819l-2.651 3.029a1.2 1.2 0 1 1-1.697-1.697l2.758-3.15-2.759-3.152a1.2 1.2 0 1 1 1.697-1.697L10 8.183l2.651-3.031a1.2 1.2 0 1 1 1.697 1.697l-2.758 3.152 2.758 3.15a1.2 1.2 0 0 1 0 1.698z"/>
                </svg>
              </span>
            </div>
          <% end %>
          
          <!-- Main Content -->
          <main class="flex-1 overflow-y-auto">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 md:pt-6 pt-20">
              <%= yield %>
            </div>
          </main>
        </div>
      </div>
    <% else %>
      <!-- Unauthenticated Layout -->
      <div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-8">
          <div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
              RapidMarkt
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
              AI Marketing Platform for SMEs
            </p>
          </div>
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
