<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create Brand Voice - RapidMarkt</title>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 min-h-screen">
  <!-- Header -->
  <header class="bg-white/80 backdrop-blur-md border-b border-slate-200/60 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo and Navigation -->
        <div class="flex items-center space-x-8">
          <div class="flex items-center">
            <div class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
              RapidMarkt
            </div>
          </div>
          
          <nav class="hidden md:flex space-x-6">
            <%= link_to "Dashboard", dashboard_path, class: "text-slate-600 hover:text-slate-900 px-3 py-2 text-sm font-medium transition-colors" %>
            <%= link_to "Templates", templates_path, class: "text-slate-600 hover:text-slate-900 px-3 py-2 text-sm font-medium transition-colors" %>
            <%= link_to "Brand Voices", brand_voices_path, class: "text-blue-600 px-3 py-2 text-sm font-medium" %>
            <%= link_to "Campaigns", campaigns_path, class: "text-slate-600 hover:text-slate-900 px-3 py-2 text-sm font-medium transition-colors" %>
          </nav>
        </div>

        <!-- Brand Voice Form -->
        <div class="flex items-center space-x-4">
          <%= form_with model: @brand_voice, local: true, class: "flex items-center space-x-3" do |form| %>
            <%= form.text_field :name, 
                placeholder: "Brand Voice Name", 
                class: "px-5 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 transition-all duration-300 placeholder-slate-400 min-w-[220px] shadow-sm hover:shadow-md focus:shadow-lg" %>
            
            <%= form.select :tone, 
                options_for_select(BrandVoice.tones.keys.map { |tone| [tone.humanize.titleize, tone] }, @brand_voice.tone), 
                { prompt: 'Select Tone' }, 
                { class: "px-5 py-3 text-sm bg-white/90 backdrop-blur-sm rounded-2xl focus:ring-2 focus:ring-blue-500 border border-slate-200 transition-all duration-300 min-w-[180px] shadow-sm hover:shadow-md focus:shadow-lg" } %>
          <% end %>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center space-x-3">
          <button type="button" 
                  onclick="previewBrandVoice()" 
                  class="px-6 py-3 text-sm font-medium text-slate-700 bg-white/90 backdrop-blur-sm rounded-2xl border border-slate-200 hover:bg-white hover:shadow-md transition-all duration-300 shadow-sm">
            <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            Preview
          </button>
          
          <button type="button" 
                  onclick="saveDraft()" 
                  class="px-6 py-3 text-sm font-medium text-blue-700 bg-blue-50 rounded-2xl border border-blue-200 hover:bg-blue-100 transition-all duration-300 shadow-sm hover:shadow-md">
            <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            Save Draft
          </button>
          
          <button type="button" 
                  onclick="publishBrandVoice()" 
                  class="px-6 py-3 text-sm font-medium text-white bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
            <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            Create Brand Voice
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Status Bar -->
  <div class="bg-white/60 backdrop-blur-sm border-b border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-12">
        <div class="flex items-center space-x-6 text-sm">
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 bg-amber-400 rounded-full"></div>
            <span class="text-slate-600">Status: <span class="font-medium text-amber-600">Draft</span></span>
          </div>
          <div class="text-slate-500">
            Last saved: <span id="last-saved-time">Never</span>
          </div>
        </div>
        
        <div class="flex items-center space-x-4">
          <label class="flex items-center space-x-2 text-sm text-slate-600">
            <input type="checkbox" id="auto-save" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
            <span>Auto-save</span>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Brand Voice Builder -->
      <div class="lg:col-span-3">
        <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl border border-slate-200/60 overflow-hidden">
          <!-- Canvas Header -->
          <div class="bg-gradient-to-r from-slate-50 to-blue-50 px-6 py-4 border-b border-slate-200/60">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <h2 class="text-lg font-semibold text-slate-800">Brand Voice Builder</h2>
                <div class="flex items-center space-x-2">
                  <button class="px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-100 rounded-lg hover:bg-blue-200 transition-colors">
                    Form View
                  </button>
                  <button class="px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">
                    Preview
                  </button>
                </div>
              </div>
              
              <div class="flex items-center space-x-2">
                <button class="p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </button>
                <button class="p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Canvas Content -->
          <div class="p-8">
            <%= form_with model: @brand_voice, local: true, id: "brand-voice-form", class: "space-y-8" do |form| %>
              <% if @brand_voice.errors.any? %>
                <div class="rounded-2xl bg-red-50 p-6 border border-red-200">
                  <div class="flex">
                    <div class="flex-shrink-0">
                      <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <div class="ml-3">
                      <h3 class="text-sm font-medium text-red-800">Please fix the following errors:</h3>
                      <div class="mt-2 text-sm text-red-700">
                        <ul class="list-disc pl-5 space-y-1">
                          <% @brand_voice.errors.full_messages.each do |message| %>
                            <li><%= message %></li>
                          <% end %>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <!-- Basic Information -->
              <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-200/60">
                <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                  <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Basic Information
                </h3>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                  <div>
                    <%= form.label :name, class: "block text-sm font-medium text-slate-700 mb-2" %>
                    <%= form.text_field :name, 
                        class: "w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md",
                        placeholder: "e.g., Professional, Friendly, Casual" %>
                    <p class="mt-1 text-xs text-slate-500">A descriptive name for this brand voice</p>
                  </div>

                  <div>
                    <%= form.label :tone, class: "block text-sm font-medium text-slate-700 mb-2" %>
                    <%= form.select :tone, 
                        options_for_select(BrandVoice.tones.keys.map { |tone| [tone.humanize, tone] }, @brand_voice.tone),
                        { prompt: "Select a tone" },
                        { class: "w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md" } %>
                    <p class="mt-1 text-xs text-slate-500">The overall tone of communication</p>
                  </div>
                </div>

                <div class="mt-6">
                  <%= form.label :description, class: "block text-sm font-medium text-slate-700 mb-2" %>
                  <%= form.text_area :description, 
                      rows: 3,
                      class: "w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md",
                      placeholder: "Describe when and how this brand voice should be used..." %>
                  <p class="mt-1 text-xs text-slate-500">Optional description of this brand voice</p>
                </div>
              </div>

              <!-- Personality Traits -->
              <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-2xl p-6 border border-green-200/60">
                <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                  <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Personality Traits
                </h3>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                  <% %w[professional friendly casual authoritative empathetic confident humorous sophisticated approachable expert conversational inspiring trustworthy innovative].each do |trait| %>
                    <label class="relative flex items-start p-3 bg-white/60 backdrop-blur-sm rounded-xl border border-green-200/60 hover:bg-white/80 transition-all duration-300 cursor-pointer">
                      <div class="flex items-center h-5">
                        <input type="checkbox" 
                               name="brand_voice[personality_traits][]" 
                               value="<%= trait %>"
                               class="focus:ring-green-500 h-4 w-4 text-green-600 border-slate-300 rounded"
                               <%= 'checked' if @brand_voice.personality_traits_list.include?(trait) %>>
                      </div>
                      <div class="ml-3 text-sm">
                        <span class="font-medium text-slate-700"><%= trait.humanize %></span>
                      </div>
                    </label>
                  <% end %>
                </div>
                <p class="mt-4 text-xs text-slate-500">Select personality traits that define this brand voice</p>
              </div>

              <!-- Vocabulary Preferences -->
              <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl p-6 border border-purple-200/60">
                <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                  <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  Vocabulary Preferences
                </h3>
                <div class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">Preferred Words/Phrases</label>
                    <textarea name="brand_voice[vocabulary_preferences][preferred_words]" 
                              rows="2" 
                              class="w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md"
                              placeholder="Enter preferred words or phrases, separated by commas"><%= @brand_voice.vocabulary_preferences_hash['preferred_words'] %></textarea>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">Words to Avoid</label>
                    <textarea name="brand_voice[vocabulary_preferences][avoid_words]" 
                              rows="2" 
                              class="w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md"
                              placeholder="Enter words to avoid, separated by commas"><%= @brand_voice.vocabulary_preferences_hash['avoid_words'] %></textarea>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">Industry Terminology</label>
                    <textarea name="brand_voice[vocabulary_preferences][industry_terms]" 
                              rows="2" 
                              class="w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md"
                              placeholder="Enter industry-specific terms, separated by commas"><%= @brand_voice.vocabulary_preferences_hash['industry_terms'] %></textarea>
                  </div>
                </div>
                <p class="mt-4 text-xs text-slate-500">Define vocabulary preferences for this brand voice</p>
              </div>

              <!-- Writing Style Rules -->
              <div class="bg-gradient-to-r from-orange-50 to-red-50 rounded-2xl p-6 border border-orange-200/60">
                <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                  <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                  </svg>
                  Writing Style Rules
                </h3>
                <div class="space-y-4">
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                      <label class="block text-sm font-medium text-slate-700 mb-2">Sentence Length</label>
                      <select name="brand_voice[writing_style_rules][sentence_length]" 
                              class="w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md">
                        <option value="">Select preference</option>
                        <option value="short" <%= 'selected' if @brand_voice.writing_style_rules_hash['sentence_length'] == 'short' %>>Short & Punchy</option>
                        <option value="medium" <%= 'selected' if @brand_voice.writing_style_rules_hash['sentence_length'] == 'medium' %>>Medium Length</option>
                        <option value="long" <%= 'selected' if @brand_voice.writing_style_rules_hash['sentence_length'] == 'long' %>>Long & Detailed</option>
                        <option value="varied" <%= 'selected' if @brand_voice.writing_style_rules_hash['sentence_length'] == 'varied' %>>Varied</option>
                      </select>
                    </div>
                    <div>
                      <label class="block text-sm font-medium text-slate-700 mb-2">Formality Level</label>
                      <select name="brand_voice[writing_style_rules][formality]" 
                              class="w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md">
                        <option value="">Select level</option>
                        <option value="very_formal" <%= 'selected' if @brand_voice.writing_style_rules_hash['formality'] == 'very_formal' %>>Very Formal</option>
                        <option value="formal" <%= 'selected' if @brand_voice.writing_style_rules_hash['formality'] == 'formal' %>>Formal</option>
                        <option value="neutral" <%= 'selected' if @brand_voice.writing_style_rules_hash['formality'] == 'neutral' %>>Neutral</option>
                        <option value="casual" <%= 'selected' if @brand_voice.writing_style_rules_hash['formality'] == 'casual' %>>Casual</option>
                        <option value="very_casual" <%= 'selected' if @brand_voice.writing_style_rules_hash['formality'] == 'very_casual' %>>Very Casual</option>
                      </select>
                    </div>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">Additional Style Guidelines</label>
                    <textarea name="brand_voice[writing_style_rules][guidelines]" 
                              rows="3" 
                              class="w-full px-4 py-3 bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all duration-300 shadow-sm hover:shadow-md"
                              placeholder="Enter specific writing style guidelines..."><%= @brand_voice.writing_style_rules_hash['guidelines'] %></textarea>
                  </div>
                </div>
                <p class="mt-4 text-xs text-slate-500">Define writing style rules and guidelines</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl border border-slate-200/60 overflow-hidden sticky top-24">
          <!-- Sidebar Header -->
          <div class="bg-gradient-to-r from-slate-50 to-blue-50 px-6 py-4 border-b border-slate-200/60">
            <h3 class="text-lg font-semibold text-slate-800">Brand Voice Tools</h3>
          </div>

          <!-- Sidebar Content -->
          <div class="p-6 space-y-6">
            <!-- Quick Actions -->
            <div>
              <h4 class="text-sm font-medium text-slate-700 mb-3">Quick Actions</h4>
              <div class="space-y-2">
                <button type="button" 
                        onclick="testBrandVoice()" 
                        class="w-full px-4 py-3 text-sm font-medium text-blue-700 bg-blue-50 rounded-xl border border-blue-200 hover:bg-blue-100 transition-all duration-300">
                  <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                  Test Voice
                </button>
                
                <button type="button" 
                        onclick="importFromTemplate()" 
                        class="w-full px-4 py-3 text-sm font-medium text-slate-700 bg-slate-50 rounded-xl border border-slate-200 hover:bg-slate-100 transition-all duration-300">
                  <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                  </svg>
                  Import from Template
                </button>
              </div>
            </div>

            <!-- Voice Examples -->
            <div>
              <h4 class="text-sm font-medium text-slate-700 mb-3">Voice Examples</h4>
              <div class="space-y-3">
                <div class="p-3 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border border-blue-200/60">
                  <h5 class="text-xs font-medium text-blue-800 mb-1">Professional</h5>
                  <p class="text-xs text-blue-700">"We are pleased to inform you that your request has been processed successfully."</p>
                </div>
                
                <div class="p-3 bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl border border-green-200/60">
                  <h5 class="text-xs font-medium text-green-800 mb-1">Friendly</h5>
                  <p class="text-xs text-green-700">"Great news! We've got your request sorted out and you're all set to go."</p>
                </div>
                
                <div class="p-3 bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl border border-purple-200/60">
                  <h5 class="text-xs font-medium text-purple-800 mb-1">Casual</h5>
                  <p class="text-xs text-purple-700">"Hey! Just wanted to let you know we've taken care of everything for you."</p>
                </div>
              </div>
            </div>

            <!-- Tips -->
            <div>
              <h4 class="text-sm font-medium text-slate-700 mb-3">Tips</h4>
              <div class="space-y-2 text-xs text-slate-600">
                <div class="flex items-start space-x-2">
                  <div class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-1.5 flex-shrink-0"></div>
                  <p>Choose 3-5 personality traits that best represent your brand</p>
                </div>
                <div class="flex items-start space-x-2">
                  <div class="w-1.5 h-1.5 bg-green-500 rounded-full mt-1.5 flex-shrink-0"></div>
                  <p>Be specific with vocabulary preferences to maintain consistency</p>
                </div>
                <div class="flex items-start space-x-2">
                  <div class="w-1.5 h-1.5 bg-purple-500 rounded-full mt-1.5 flex-shrink-0"></div>
                  <p>Test your brand voice with different content types</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- JavaScript -->
  <script>
    function previewBrandVoice() {
      // Implementation for previewing brand voice
      console.log('Preview brand voice');
    }

    function saveDraft() {
      const form = document.getElementById('brand-voice-form');
      const formData = new FormData(form);
      
      // Add draft status
      formData.append('brand_voice[status]', 'draft');
      
      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          showNotification('Draft saved successfully!', 'success');
          updateLastSaved();
        } else {
          showNotification('Failed to save draft', 'error');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        showNotification('Failed to save draft', 'error');
      });
    }

    function publishBrandVoice() {
      const form = document.getElementById('brand-voice-form');
      form.submit();
    }

    function testBrandVoice() {
      // Implementation for testing brand voice
      console.log('Test brand voice');
    }

    function importFromTemplate() {
      // Implementation for importing from template
      console.log('Import from template');
    }

    function showNotification(message, type) {
      // Create and show notification
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 ${
        type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
      }`;
      notification.textContent = message;
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.remove();
      }, 3000);
    }

    function updateLastSaved() {
      const now = new Date();
      const timeString = now.toLocaleTimeString('en-US', { 
        hour: '2-digit', 
        minute: '2-digit' 
      });
      document.getElementById('last-saved-time').textContent = timeString;
    }

    // Auto-save functionality
    function setupAutoSave() {
      const form = document.getElementById('brand-voice-form');
      const autoSaveCheckbox = document.getElementById('auto-save');
      
      if (form && autoSaveCheckbox) {
        const inputs = form.querySelectorAll('input, textarea, select');
        
        inputs.forEach(input => {
          input.addEventListener('input', () => {
            if (autoSaveCheckbox.checked) {
              clearTimeout(window.autoSaveTimeout);
              window.autoSaveTimeout = setTimeout(() => {
                saveDraft();
              }, 2000); // Auto-save after 2 seconds of inactivity
            }
          });
        });
      }
    }

    // Initialize auto-save when page loads
    document.addEventListener('DOMContentLoaded', setupAutoSave);
  </script>
</body>
</html>
