<!-- Modern Analytics Container -->
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50">
  <!-- Enhanced Header Section -->
  <div class="bg-white/80 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-10">
    <div class="px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
        <!-- Header Content -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center">
            <div>
              <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
                Analytics Dashboard
              </h1>
              <p class="mt-1 text-lg text-gray-600">
                Track your email campaign performance and engagement metrics.
              </p>
            </div>
            <div class="ml-4 hidden sm:block">
              <div class="flex items-center space-x-2">
                <div class="h-2 w-2 bg-green-400 rounded-full animate-pulse"></div>
                <span class="text-sm text-gray-500">Live analytics</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Enhanced Controls -->
        <div class="mt-4 lg:mt-0 flex flex-col sm:flex-row items-stretch sm:items-center space-y-3 sm:space-y-0 sm:space-x-3">
          <%= form_with url: analytics_path, method: :get, local: true, class: "flex items-center space-x-3" do |form| %>
            <div class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <%= form.select :date_range, 
                  options_for_select([
                    ['Last 7 days', '7d'],
                    ['Last 30 days', '30d'],
                    ['Last 90 days', '90d'],
                    ['This year', '1y']
                  ], params[:date_range] || '30d'),
                  {},
                  { class: "block w-full pl-3 pr-10 py-2 text-sm border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 hover:border-gray-400" } %>
            </div>
            <%= form.submit "Update", 
                class: "inline-flex items-center px-6 py-2 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" %>
          <% end %>
          
          <%= link_to analytics_export_path(format: :csv, date_range: params[:date_range]), 
              class: "inline-flex items-center px-6 py-2 border border-gray-300 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <svg class="w-4 h-4 mr-2 text-gray-500" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
            Export Data
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="px-4 sm:px-6 lg:px-8 py-8">

    <!-- Enhanced Overview Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Campaigns Card -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-200">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Total Campaigns</p>
              <p class="text-3xl font-bold text-gray-900 mt-2"><%= @overview_stats[:total_campaigns] %></p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-green-600 font-medium">+15%</span>
                <span class="text-sm text-gray-500 ml-1">from last period</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-3">
          <%= link_to campaigns_path, class: "text-sm font-medium text-blue-700 hover:text-blue-900 flex items-center group" do %>
            View campaigns
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      </div>

      <!-- Total Emails Sent Card -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-200">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Emails Sent</p>
              <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@overview_stats[:total_sent]) %></p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-green-600 font-medium">+22%</span>
                <span class="text-sm text-gray-500 ml-1">from last period</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-green-50 to-emerald-50 px-6 py-3">
          <span class="text-sm font-medium text-green-700">Active delivery rate: 98.2%</span>
        </div>
      </div>

      <!-- Average Open Rate Card -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-200">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Avg Open Rate</p>
              <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_to_percentage(@overview_stats[:avg_open_rate], precision: 1) %></p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-green-600 font-medium">+3.2%</span>
                <span class="text-sm text-gray-500 ml-1">from last period</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-purple-50 to-pink-50 px-6 py-3">
          <span class="text-sm font-medium text-purple-700">Industry avg: 21.3%</span>
        </div>
      </div>

      <!-- Total Contacts Card -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-200">
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Total Contacts</p>
              <p class="text-3xl font-bold text-gray-900 mt-2"><%= number_with_delimiter(@overview_stats[:total_contacts]) %></p>
              <div class="flex items-center mt-2">
                <span class="text-sm text-green-600 font-medium">+8%</span>
                <span class="text-sm text-gray-500 ml-1">from last period</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-r from-orange-50 to-red-50 px-6 py-3">
          <%= link_to contacts_path, class: "text-sm font-medium text-orange-700 hover:text-orange-900 flex items-center group" do %>
            Manage contacts
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Enhanced Charts Section -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 mb-8">
      <!-- Engagement Trends Chart -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 hover:shadow-lg transition-all duration-300">
        <div class="p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">Engagement Trends</h3>
              <p class="text-sm text-gray-600">Email opens and clicks over time</p>
            </div>
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 rounded-full bg-blue-500"></div>
              <span class="text-xs text-gray-600">Opens</span>
              <div class="w-3 h-3 rounded-full bg-purple-500"></div>
              <span class="text-xs text-gray-600">Clicks</span>
            </div>
          </div>
          <div class="h-64 flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border-2 border-dashed border-gray-300">
            <div class="text-center">
              <div class="w-16 h-16 mx-auto bg-gradient-to-br from-indigo-100 to-purple-100 rounded-2xl flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <p class="text-sm font-medium text-gray-900 mb-1">Interactive Chart Coming Soon</p>
              <p class="text-xs text-gray-500">Integration with charting library in progress</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Campaign Performance -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 hover:shadow-lg transition-all duration-300">
        <div class="p-6">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">Top Campaigns</h3>
              <p class="text-sm text-gray-600">Best performing by open rate</p>
            </div>
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <div class="space-y-4">
            <% if @campaign_performance.any? %>
              <% @campaign_performance.each_with_index do |campaign, index| %>
                <div class="flex items-center justify-between p-4 bg-gradient-to-r from-gray-50 to-white rounded-xl border border-gray-200 hover:shadow-md transition-all duration-200">
                  <div class="flex items-center flex-1 min-w-0">
                    <div class="flex-shrink-0 mr-4">
                      <span class="inline-flex items-center justify-center h-8 w-8 rounded-full text-xs font-semibold
                        <%= case index
                            when 0 then 'bg-gradient-to-r from-yellow-400 to-orange-500 text-white'
                            when 1 then 'bg-gradient-to-r from-gray-300 to-gray-400 text-gray-800'
                            when 2 then 'bg-gradient-to-r from-orange-400 to-amber-500 text-white'
                            else 'bg-gradient-to-r from-indigo-100 to-purple-100 text-indigo-800'
                            end %>">
                        <%= index + 1 %>
                      </span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <%= link_to campaign_path(campaign[:id]), class: "block" do %>
                        <p class="text-sm font-semibold text-gray-900 hover:text-indigo-600 truncate transition-colors duration-200">
                          <%= campaign[:name] %>
                        </p>
                        <p class="text-xs text-gray-500 truncate"><%= campaign[:subject] %></p>
                      <% end %>
                    </div>
                  </div>
                  <div class="flex-shrink-0 text-right ml-4">
                    <div class="text-sm font-bold text-gray-900">
                      <%= number_to_percentage(campaign[:open_rate], precision: 1) %>
                    </div>
                    <div class="text-xs text-gray-500">
                      <%= pluralize(campaign[:opens], 'open') %> / <%= pluralize(campaign[:sent], 'sent') %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-8">
                <div class="w-12 h-12 mx-auto bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl flex items-center justify-center mb-4">
                  <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <p class="text-sm font-medium text-gray-900 mb-1">No campaigns found</p>
                <p class="text-xs text-gray-500">No data available for the selected period</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Enhanced Detailed Sections -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Recent Campaign Performance -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 hover:shadow-lg transition-all duration-300">
        <div class="p-6">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">Recent Campaigns</h3>
              <p class="text-sm text-gray-600">Latest campaign performance</p>
            </div>
            <%= link_to campaigns_path, class: "inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-700 transition-colors duration-200" do %>
              View all
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            <% end %>
          </div>
          
          <% if @campaign_performance.any? %>
            <div class="space-y-3">
              <% @campaign_performance.first(5).each do |campaign_data| %>
                <div class="bg-gradient-to-r from-gray-50 to-white rounded-xl p-4 border border-gray-200 hover:shadow-md transition-all duration-200">
                  <div class="flex items-center justify-between">
                    <div class="flex-1 min-w-0">
                      <%= link_to campaign_path(campaign_data[:id]), class: "block" do %>
                        <p class="text-sm font-semibold text-gray-900 hover:text-indigo-600 truncate transition-colors duration-200">
                          <%= campaign_data[:name] %>
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                          Sent <%= time_ago_in_words(campaign_data[:sent_at]) %> ago
                        </p>
                      <% end %>
                    </div>
                    <div class="flex items-center space-x-4 ml-4">
                      <div class="text-center">
                        <p class="text-sm font-bold text-gray-900"><%= number_with_delimiter(campaign_data[:emails_sent]) %></p>
                        <p class="text-xs text-gray-500">sent</p>
                      </div>
                      <div class="text-center">
                        <p class="text-sm font-bold text-gray-900"><%= number_with_delimiter(campaign_data[:opens]) %></p>
                        <p class="text-xs text-gray-500">opens</p>
                      </div>
                      <div class="text-center">
                        <p class="text-sm font-bold text-indigo-600"><%= number_to_percentage(campaign_data[:open_rate], precision: 1) %></p>
                        <p class="text-xs text-gray-500">rate</p>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="w-12 h-12 mx-auto bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <p class="text-sm font-medium text-gray-900 mb-1">No recent campaigns</p>
              <p class="text-xs text-gray-500">Start creating campaigns to see performance data</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Contact Growth -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200 hover:shadow-lg transition-all duration-300">
        <div class="p-6">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">Contact Growth</h3>
              <p class="text-sm text-gray-600">Subscriber analytics</p>
            </div>
            <%= link_to contacts_path, class: "inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-700 transition-colors duration-200" do %>
              View contacts
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            <% end %>
          </div>
          
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-4 border border-green-200">
              <div class="text-center">
                <div class="text-2xl font-bold text-green-700"><%= @contact_growth[:new_contacts] %></div>
                <div class="text-sm text-green-600 font-medium">New contacts</div>
              </div>
            </div>
            <div class="bg-gradient-to-r from-red-50 to-pink-50 rounded-xl p-4 border border-red-200">
              <div class="text-center">
                <div class="text-2xl font-bold text-red-700"><%= @contact_growth[:unsubscribed] %></div>
                <div class="text-sm text-red-600 font-medium">Unsubscribed</div>
              </div>
            </div>
          </div>
          
          <div class="space-y-4">
            <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Subscription Status</h4>
            <div class="space-y-3">
              <div class="flex items-center justify-between p-3 bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200">
                <span class="text-sm font-medium text-gray-700">Active Subscribers</span>
                <span class="text-sm font-bold text-gray-900"><%= number_with_delimiter(@contact_growth[:subscribed]) %></span>
              </div>
              <div class="flex items-center justify-between p-3 bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200">
                <span class="text-sm font-medium text-gray-700">Total Unsubscribed</span>
                <span class="text-sm font-bold text-gray-900"><%= number_with_delimiter(@contact_growth[:total_unsubscribed]) %></span>
              </div>
              <div class="flex items-center justify-between p-3 bg-gradient-to-r from-indigo-50 to-purple-50 rounded-lg border border-indigo-200">
                <span class="text-sm font-medium text-indigo-700">Growth Rate</span>
                <span class="text-sm font-bold text-indigo-800">+<%= (((@contact_growth[:new_contacts].to_f - @contact_growth[:unsubscribed].to_f) / [@contact_growth[:subscribed].to_f, 1].max) * 100).round(1) %>%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>