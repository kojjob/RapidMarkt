<% content_for :title, @tag.name %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div class="flex items-center">
        <%= link_to tags_path, class: "text-gray-400 hover:text-gray-600 mr-4" do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">🏷️ <%= @tag.name %></h1>
          <p class="mt-2 text-sm text-gray-700">
            <span class="text-gray-500">Created <%= time_ago_in_words(@tag.created_at) %> ago</span>
          </p>
        </div>
      </div>
      
      <div class="flex items-center space-x-3">
        <%= link_to edit_tag_path(@tag), 
            class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
        
        <%= link_to @tag, data: { turbo_method: :delete, confirm: "Are you sure you want to delete this tag?" },
            class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Description -->
      <% if @tag.description.present? %>
        <div class="bg-white shadow rounded-lg p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-4">📝 Description</h2>
          <p class="text-gray-700 leading-relaxed"><%= simple_format(@tag.description) %></p>
        </div>
      <% end %>

      <!-- Contacts with this tag -->
      <div class="bg-white shadow rounded-lg p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-medium text-gray-900">👥 Tagged Contacts</h2>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
            <%= @tag.contacts.count %> contacts
          </span>
        </div>
        
        <% if @tag.contacts.any? %>
          <div class="space-y-3">
            <% @tag.contacts.limit(10).each do |contact| %>
              <div class="flex items-center justify-between py-3 border-b border-gray-200 last:border-b-0">
                <div class="flex items-center">
                  <div class="h-10 w-10 rounded-full bg-indigo-500 flex items-center justify-center">
                    <span class="text-sm font-medium text-white">
                      <%= contact.first_name&.first || contact.email.first.upcase %>
                    </span>
                  </div>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900">
                      <%= contact.full_name.present? ? contact.full_name : contact.email %>
                    </p>
                    <p class="text-sm text-gray-500"><%= contact.email %></p>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <%= link_to "View", contact, class: "text-indigo-600 hover:text-indigo-500 text-sm font-medium" %>
                </div>
              </div>
            <% end %>
            
            <% if @tag.contacts.count > 10 %>
              <div class="text-center pt-4">
                <%= link_to "View All Contacts", contacts_path(tag: @tag.name), 
                    class: "text-indigo-600 hover:text-indigo-500 text-sm font-medium" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No contacts tagged</h3>
            <p class="mt-1 text-sm text-gray-500">
              Start by adding this tag to your contacts.
            </p>
            <div class="mt-6">
              <%= link_to "View All Contacts", contacts_path, 
                  class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Tag Stats -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">📊 Tag Statistics</h2>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-600">Total Contacts</span>
            <span class="text-sm font-medium text-gray-900"><%= @tag.contacts.count %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-600">Campaigns Sent</span>
            <span class="text-sm font-medium text-gray-900">
              <%= @tag.contacts.joins(:campaign_contacts).where.not(campaign_contacts: { sent_at: nil }).count %>
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-600">Created</span>
            <span class="text-sm font-medium text-gray-900"><%= @tag.created_at.strftime("%b %d, %Y") %></span>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">⚡ Quick Actions</h2>
        <div class="space-y-3">
          <%= link_to contacts_path(tag: @tag.name), 
              class: "block w-full text-left px-4 py-2 text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-md transition-colors" do %>
            📋 View All Tagged Contacts
          <% end %>
          
          <%= link_to new_campaign_path(tag: @tag.name), 
              class: "block w-full text-left px-4 py-2 text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-md transition-colors" do %>
            📧 Create Campaign for Tag
          <% end %>
          
          <%= link_to edit_tag_path(@tag), 
              class: "block w-full text-left px-4 py-2 text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-md transition-colors" do %>
            ✏️ Edit Tag Details
          <% end %>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">🕒 Recent Activity</h2>
        <div class="space-y-3">
          <% recent_contacts = @tag.contact_tags.includes(:contact).order(created_at: :desc).limit(5) %>
          <% if recent_contacts.any? %>
            <% recent_contacts.each do |contact_tag| %>
              <div class="text-sm">
                <span class="font-medium text-gray-900"><%= contact_tag.contact.email %></span>
                <span class="text-gray-500">tagged</span>
                <span class="text-gray-400"><%= time_ago_in_words(contact_tag.created_at) %> ago</span>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500">No recent activity</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>